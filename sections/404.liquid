{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.
{% endcomment %}

{% if request.path == '/pages/kitty-app-privacy-policy' or request.path contains 'kitty-app-privacy-policy' %}
  {% section 'kitty-app-privacy-policy' %}
{% else %}
  <div class="page-width container" style="text-align: center; padding: 6rem 2rem;">
    <h1>{{ '404.title' | t }}</h1>
    <p>{{ '404.not_found' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="button">
      {{ '404.back_to_shopping' | t }}
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
