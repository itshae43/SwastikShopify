{% stylesheet %}
  .find-store-page {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    color: #333;
    background-color: #FAFAFA;
    overflow: hidden;
  }
  
  .fs-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  /* --- HERO SECTION --- */
  .fs-hero {
    display: flex;
    flex-wrap: wrap;
    background: linear-gradient(135deg, #FFF9F2 0%, #F5EBE1 100%);
    position: relative;
    border-bottom: 1px solid #efe4d8;
  }
  .fs-hero-content {
    flex: 1 1 500px;
    padding: 80px 5%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .fs-hero-image {
    flex: 1 1 500px;
    min-height: 500px;
    position: relative;
  }
  .fs-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0; left: 0;
  }
  .fs-hero-subtitle {
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #b08958;
    margin-bottom: 15px;
  }
  .fs-hero-title {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 5.5rem;
    color: #013F3E;
    line-height: 1.1;
    margin-bottom: 25px;
    font-weight: 500;
  }
  .fs-hero-divider {
    width: 60px;
    height: 1px;
    background-color: #b08958;
    margin-bottom: 25px;
    position: relative;
  }
  .fs-hero-divider::after {
    content: '❖';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: transparent;
    color: #b08958;
    font-size: 14px;
    padding: 0 5px;
  }
  .fs-hero-text {
    font-size: 1.5rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 40px;
    max-width: 450px;
  }
  .fs-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }
  .fs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 4px;
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .fs-btn-primary {
    background-color: #013F3E;
    color: white;
  }
  .fs-btn-primary:hover {
    background-color: #025958;
  }
  .fs-btn-secondary {
    background-color: white;
    border-color: #ddd;
    color: #333;
  }
  .fs-btn-secondary:hover {
    border-color: #013F3E;
    color: #013F3E;
  }
  .fs-btn-gold {
    background-color: #b08958;
    color: white;
  }
  .fs-btn-gold:hover {
    background-color: #9c7849;
  }

  /* --- DETAILS & MAP --- */
  .fs-details-section {
    padding: 60px 0;
  }
  .fs-details-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0px;
    background: white;
    box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    border-radius: 12px;
    overflow: hidden;
  }
  .fs-details-info {
    flex: 1 1 350px;
    padding: 50px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .fs-details-map {
    flex: 2 1 500px;
    min-height: 400px;
    position: relative;
    background: #e9e9e9;
  }
  .fs-details-map iframe {
    width: 100%;
    height: 100%;
    border: none;
    position: absolute;
    top: 0; left: 0;
  }
  .fs-store-name {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 3rem;
    color: #013F3E;
    margin-bottom: 30px;
  }
  .fs-info-row {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 20px;
  }
  .fs-info-icon {
    width: 22px;
    height: 22px;
    color: #b08958;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .fs-info-text {
    font-size: 1.35rem;
    line-height: 1.5;
    color: #555;
  }
  .fs-info-text strong {
    color: #222;
    display: block;
    margin-bottom: 2px;
    font-weight: 600;
  }
  .fs-info-text a {
    color: #555;
    text-decoration: none;
  }
  .fs-info-text a:hover {
    color: #b08958;
  }
  .fs-facilities {
    display: flex;
    gap: 15px;
    margin-top: 25px;
    padding-top: 30px;
    border-top: 1px solid #f0f0f0;
  }
  .fs-facility-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    font-size: 1.1rem;
    color: #555;
    flex: 1;
    font-weight: 500;
  }
  .fs-facility-icon {
    width: 40px;
    height: 40px;
    color: #b08958;
    background: #FFF9F2;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fs-facility-icon svg {
    width: 20px;
    height: 20px;
  }

  /* --- WHY VISIT US --- */
  .fs-features-section {
    padding: 70px 0;
    background: #FAF8F5;
    border-top: 1px solid #efe4d8;
    border-bottom: 1px solid #efe4d8;
  }
  .fs-section-title {
    text-align: center;
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 2.8rem;
    color: #013F3E;
    margin-bottom: 15px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .fs-title-divider {
    width: 40px;
    height: 1px;
    background: #b08958;
    margin: 0 auto 50px;
    position: relative;
  }
  .fs-title-divider::after {
    content: '❖';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #FAF8F5;
    color: #b08958;
    font-size: 14px;
    padding: 0 5px;
  }
  .fs-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 30px;
    text-align: center;
  }
  .fs-feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }
  .fs-feature-icon {
    width: 55px;
    height: 55px;
    color: #013F3E;
  }
  .fs-feature-text {
    font-size: 1.3rem;
    color: #333;
    font-weight: 500;
    line-height: 1.4;
  }

  /* --- APPOINTMENT SECTION --- */
  .fs-appointment-section {
    padding: 80px 0;
  }
  .fs-appointment-wrapper {
    background: #013F3E;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    color: white;
  }
  .fs-apt-content {
    flex: 1 1 300px;
    padding: 60px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .fs-apt-subtitle {
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #b08958;
    margin-bottom: 12px;
  }
  .fs-apt-title {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 4rem;
    margin-bottom: 20px;
    line-height: 1.1;
  }
  .fs-apt-text {
    font-size: 1.4rem;
    color: #e0e0e0;
    line-height: 1.6;
    margin-bottom: 30px;
  }
  .fs-apt-divider {
    width: 40px;
    height: 1px;
    background: #b08958;
    position: relative;
  }
  .fs-apt-divider::after {
    content: '❖';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #013F3E;
    color: #b08958;
    font-size: 14px;
    padding: 0 5px;
  }
  .fs-apt-form-wrapper {
    flex: 2 1 450px;
    background: white;
    padding: 40px;
    margin: 20px 0 20px 0;
    border-radius: 8px 0 0 8px;
    color: #333;
  }
  .fs-apt-image {
    flex: 1 1 250px;
    position: relative;
    min-height: 300px;
  }
  .fs-apt-image img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .fs-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .fs-form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fs-form-field label {
    font-size: 1.2rem;
    font-weight: 500;
    color: #444;
  }
  .fs-form-input {
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1.3rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    background: #fafafa;
    color: #333;
  }
  .fs-form-input:focus {
    outline: none;
    border-color: #013F3E;
  }
  .fs-form-submit {
    grid-column: 1 / -1;
    margin-top: 10px;
  }

  /* --- STATS SECTION --- */
  .fs-stats-section {
    padding: 0 0 70px;
  }
  .fs-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    border-top: 1px solid #eaeaea;
    border-bottom: 1px solid #eaeaea;
    padding: 40px 0;
  }
  .fs-stat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }
  .fs-stat-icon {
    width: 45px;
    height: 45px;
    color: #b08958;
  }
  .fs-stat-content h4 {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 1.8rem;
    color: #111;
    margin: 0 0 4px;
  }
  .fs-stat-content p {
    font-size: 1.2rem;
    color: #555;
    margin: 0;
    font-weight: 500;
  }

  /* --- BOTTOM CTA --- */
  .fs-cta-section {
    padding-bottom: 80px;
  }
  .fs-cta-wrapper {
    background: #013F3E;
    border-radius: 12px;
    padding: 60px 20px;
    text-align: center;
    color: white;
  }
  .fs-cta-wrapper h2 {
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: 3.6rem;
    margin-bottom: 15px;
    color: white;
  }
  .fs-cta-wrapper p {
    font-size: 1.4rem;
    color: #e0e0e0;
    margin-bottom: 30px;
  }
  .fs-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
  }
  
  @media screen and (max-width: 990px) {
    .fs-apt-form-wrapper {
      margin: 0;
      border-radius: 0;
    }
    .fs-apt-image {
      display: none;
    }
  }

  @media screen and (max-width: 768px) {
    .fs-hero-title { font-size: 4rem; }
    .fs-store-name { font-size: 2.6rem; }
    .fs-details-wrapper, .fs-appointment-wrapper { flex-direction: column; }
    .fs-form-grid { grid-template-columns: 1fr; }
    .fs-details-map { min-height: 350px; }
    .fs-apt-form-wrapper { padding: 30px 20px; }
  }
{% endstylesheet %}

<div class="find-store-page">
  
  <!-- HERO SECTION -->
  <section class="fs-hero">
    <div class="fs-hero-content">
      <div class="fs-hero-subtitle">{{ section.settings.hero_subtitle }}</div>
      <h1 class="fs-hero-title">{{ section.settings.hero_title }}</h1>
      <div class="fs-hero-divider"></div>
      <p class="fs-hero-text">{{ section.settings.hero_text }}</p>
      <div class="fs-buttons">
        {% if section.settings.btn_directions_link != blank %}
          <a href="{{ section.settings.btn_directions_link }}" target="_blank" class="fs-btn fs-btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {{ section.settings.btn_directions_text }}
          </a>
        {% endif %}
        {% if section.settings.btn_call_link != blank %}
          <a href="tel:{{ section.settings.btn_call_link }}" class="fs-btn fs-btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {{ section.settings.btn_call_text }}
          </a>
        {% endif %}
        {% if section.settings.btn_whatsapp_link != blank %}
          <a href="{{ section.settings.btn_whatsapp_link }}" target="_blank" class="fs-btn fs-btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            {{ section.settings.btn_whatsapp_text }}
          </a>
        {% endif %}
      </div>
    </div>
    <div class="fs-hero-image">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1500 | image_tag: loading: 'lazy', alt: section.settings.hero_title }}
      {% else %}
        <div style="background: #e2d9cf; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #888;">Upload Hero Image</div>
      {% endif %}
    </div>
  </section>

  <!-- STORE DETAILS & MAP -->
  <section class="fs-details-section">
    <div class="fs-container">
      <div class="fs-details-wrapper">
        <div class="fs-details-info">
          <h2 class="fs-store-name">{{ section.settings.store_name }}</h2>
          
          <div class="fs-info-row">
            <div class="fs-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div>
            <div class="fs-info-text">
              {{ section.settings.store_address | newline_to_br }}
            </div>
          </div>
          
          <div class="fs-info-row">
            <div class="fs-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
            <div class="fs-info-text">
              <strong>{{ section.settings.store_hours | newline_to_br }}</strong>
              {% if section.settings.store_status_text != blank %}
                <span style="display:inline-block; margin-top: 5px; background: #013F3E; color: white; padding: 3px 10px; border-radius: 12px; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">{{ section.settings.store_status_text }}</span>
              {% endif %}
            </div>
          </div>
          
          <div class="fs-info-row">
            <div class="fs-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></div>
            <div class="fs-info-text">
              <a href="tel:{{ section.settings.store_phone | replace: ' ', '' }}">{{ section.settings.store_phone }}</a>
            </div>
          </div>
          
          <div class="fs-info-row">
            <div class="fs-info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></div>
            <div class="fs-info-text">
              <a href="mailto:{{ section.settings.store_email }}">{{ section.settings.store_email }}</a>
            </div>
          </div>

          <div class="fs-facilities">
            {% if section.settings.facility_1_text != blank %}
            <div class="fs-facility-item">
              <div class="fs-facility-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9 16V8h4a3 3 0 0 1 0 6H9"></path></svg>
              </div>
              {{ section.settings.facility_1_text }}
            </div>
            {% endif %}
            {% if section.settings.facility_2_text != blank %}
            <div class="fs-facility-item">
              <div class="fs-facility-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
              </div>
              {{ section.settings.facility_2_text }}
            </div>
            {% endif %}
            {% if section.settings.facility_3_text != blank %}
            <div class="fs-facility-item">
              <div class="fs-facility-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
              </div>
              {{ section.settings.facility_3_text }}
            </div>
            {% endif %}
          </div>
        </div>
        
        <div class="fs-details-map">
          {% if section.settings.map_iframe != blank %}
            {{ section.settings.map_iframe }}
          {% else %}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:20px;text-align:center;color:#888;">Please paste your Google Maps embed iframe in the theme editor.</div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY VISIT US -->
  <section class="fs-features-section">
    <div class="fs-container">
      <h2 class="fs-section-title">Why Visit Our Store?</h2>
      <div class="fs-title-divider"></div>
      
      <div class="fs-features-grid">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="fs-feature-item">
              <div class="fs-feature-icon">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon }}
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9Z"></path><path d="M11 3 8 9l4 13 4-13-3-6"></path><path d="M2 9h20"></path></svg>
                {% endif %}
              </div>
              <div class="fs-feature-text">{{ block.settings.text }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- APPOINTMENT SECTION -->
  <section class="fs-appointment-section">
    <div class="fs-container">
      <div class="fs-appointment-wrapper">
        <div class="fs-apt-content">
          <div class="fs-apt-subtitle">{{ section.settings.apt_subtitle }}</div>
          <h2 class="fs-apt-title">{{ section.settings.apt_title }}</h2>
          <p class="fs-apt-text">{{ section.settings.apt_text }}</p>
          <div class="fs-apt-divider"></div>
        </div>
        
        <div class="fs-apt-form-wrapper">
          {% form 'contact', id: 'StoreAppointmentForm' %}
            {% if form.posted_successfully? %}
              <div style="background: #e8f5e9; color: #2e7d32; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
                Your appointment request has been sent! We will contact you shortly to confirm.
              </div>
            {% elsif form.errors %}
              <div style="background: #ffebee; color: #c62828; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
                Please correct the errors and try again.
              </div>
            {% endif %}

            <input type="hidden" name="contact[Subject]" value="Store Appointment Request">
            
            <div class="fs-form-grid">
              <div class="fs-form-field">
                <label for="AptFormName">Your Name</label>
                <input type="text" id="AptFormName" name="contact[name]" class="fs-form-input" placeholder="Enter your name" required>
              </div>
              <div class="fs-form-field">
                <label for="AptFormPhone">Phone Number</label>
                <input type="tel" id="AptFormPhone" name="contact[phone]" class="fs-form-input" placeholder="Enter your number" required>
              </div>
              <div class="fs-form-field">
                <label for="AptFormDate">Preferred Date</label>
                <input type="date" id="AptFormDate" name="contact[Preferred Date]" class="fs-form-input" required>
              </div>
              <div class="fs-form-field">
                <label for="AptFormTime">Preferred Time</label>
                <input type="time" id="AptFormTime" name="contact[Preferred Time]" class="fs-form-input" required>
              </div>
              <div class="fs-form-field" style="grid-column: 1 / -1;">
                <label for="AptFormPurpose">Purpose of Visit</label>
                <select id="AptFormPurpose" name="contact[Purpose of Visit]" class="fs-form-input" style="appearance: auto;">
                  <option value="General Viewing">General Viewing</option>
                  <option value="Bridal Consultation">Bridal Consultation</option>
                  <option value="Custom Jewellery Design">Custom Jewellery Design</option>
                  <option value="Gold Exchange">Gold Exchange</option>
                  <option value="Repair / Polishing">Repair / Polishing</option>
                </select>
              </div>
              <div class="fs-form-submit">
                <button type="submit" class="fs-btn fs-btn-gold" style="width: 100%; border: none; padding: 14px; font-size: 1.3rem;">Book Appointment</button>
              </div>
            </div>
          {% endform %}
        </div>
        
        <div class="fs-apt-image">
          {% if section.settings.apt_image != blank %}
            {{ section.settings.apt_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% else %}
            <div style="background: #111; width: 100%; height: 100%;"></div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- STATS SECTION -->
  <section class="fs-stats-section">
    <div class="fs-container">
      <div class="fs-stats-grid">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="fs-stat-item">
              <div class="fs-stat-icon">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon }}
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                {% endif %}
              </div>
              <div class="fs-stat-content">
                <h4>{{ block.settings.number }}</h4>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="fs-cta-section">
    <div class="fs-container">
      <div class="fs-cta-wrapper">
        <h2>{{ section.settings.cta_title }}</h2>
        <p>{{ section.settings.cta_text }}</p>
        <div class="fs-cta-buttons">
          {% if section.settings.cta_btn1_link != blank %}
            <a href="{{ section.settings.cta_btn1_link }}" class="fs-btn fs-btn-gold">{{ section.settings.cta_btn1_text }}</a>
          {% endif %}
          {% if section.settings.cta_btn2_link != blank %}
            <a href="{{ section.settings.cta_btn2_link }}" class="fs-btn fs-btn-secondary" style="background: transparent; border-color: rgba(255,255,255,0.4); color: white;">{{ section.settings.cta_btn2_text }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

</div>

