<script>
  // Redirect /cart to homepage and open the cart drawer sidebar instead
  (function() {
    var referrer = document.referrer;
    // Go back to the page the user came from, or fallback to homepage
    var destination = (referrer && referrer !== window.location.href) ? referrer : '/';
    window.location.replace(destination);
  })();
</script>

<noscript>
  <meta http-equiv="refresh" content="0;url=/">
</noscript>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
