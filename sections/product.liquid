  #pp-main-image { width: 100%; height: 100%; object-fit: cover; cursor: zoom-in !important; transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94); }

  /* Zoom Overlay: Four Rounded Corner Way & Luxury Frosted Champagne Backdrop */
  .pp-zoom-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(250, 247, 240, 0.96); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
