{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="premium-product" data-product-id="{{ product.id }}" data-url="{{ product.url }}">
  {% render 'breadcrumb', product: product, collection: collection %}

  <div class="pp-container">
    
    <!-- LEFT COLUMN -->
    <div class="pp-left">
      <!-- Gallery -->
      <div class="pp-gallery">
        <div class="pp-main-image-wrap">

          <button class="pp-nav-btn pp-nav-prev" aria-label="Previous">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          
          <div class="pp-main-img-container">
            {% if product.featured_image %}
              <img id="pp-main-image" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" height="1000">
            {% else %}
              <img id="pp-main-image" src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Luxury Diamond Jewelry" width="1000" height="1000">
            {% endif %}
          </div>
          
          <button class="pp-nav-btn pp-nav-next" aria-label="Next">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
          
          <button class="pp-fullscreen-btn" aria-label="Fullscreen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
        </div>
        
        <!-- Thumbnails Horizontal Carousel Below Main Image -->
        <div class="pp-thumbnails-section">
          <button class="pp-thumb-nav-btn pp-thumb-nav-prev" type="button" aria-label="Previous Thumbnails">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>

          {% if product.images.size > 1 %}
            <div class="pp-thumbnails-wrapper">
              <div class="pp-thumbnails">
                {% for image in product.images %}
                  <div class="pp-thumb-item {% if forloop.first %}is-active{% endif %}" data-image="{{ image | image_url: width: 1000 }}">
                    <div class="pp-thumb-img">
                      <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | escape }}" width="180" height="180">
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <div class="pp-thumbnails-wrapper">
              <div class="pp-thumbnails">
                {% if product.featured_image %}
                  <div class="pp-thumb-item is-active" data-image="{{ product.featured_image | image_url: width: 1000 }}">
                    <div class="pp-thumb-img">
                      <img src="{{ product.featured_image | image_url: width: 180 }}" alt="{{ product.title | escape }}" width="180" height="180">
                    </div>
                  </div>
                {% endif %}
                {% assign luxury_fallbacks = "best_seller_pendant.png,best_seller_earrings.png,best_seller_ring.png,best_seller_bracelet.png" | split: "," %}
                {% for img_name in luxury_fallbacks %}
                  {% unless product.featured_image and forloop.first %}
                    <div class="pp-thumb-item {% if product.featured_image == blank and forloop.first %}is-active{% endif %}" data-image="{{ img_name | asset_url }}">
                      <div class="pp-thumb-img">
                        <img src="{{ img_name | asset_url }}" alt="Luxury Jewelry Thumbnail" width="180" height="180">
                      </div>
                    </div>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <button class="pp-thumb-nav-btn pp-thumb-nav-next" type="button" aria-label="Next Thumbnails">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>


    </div>

    <!-- RIGHT COLUMN -->
    <div class="pp-right">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="pp-header-block">
              <h1 class="pp-title">{{ product.title }}</h1>
              

              
              <div class="pp-meta-row">
                <div class="pp-reviews">
                  <div class="pp-stars">
                    {% for i in (1..5) %}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="#F5C518"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    {% endfor %}
                  </div>
                  <span class="pp-review-text">4.8 (128 Reviews)</span>
                </div>
                <div class="pp-sku-wrap">
                  <span class="pp-sku-label">SKU:</span>
                  <span class="pp-sku-val" id="pp-sku">{{ current_variant.sku | default: 'SWRK-NC-1024' }}</span>
                </div>
              </div>
            </div>

          {%- when 'price' -%}
            <div class="pp-price-box">
              <div class="pp-price-box-top">
                <span class="pp-price-current" id="pp-price">{{ current_variant.price | money }}</span>
                <span class="pp-price-tax-label">(Incl. of all taxes)</span>
              </div>
              <div class="pp-price-box-bottom">
                <span class="pp-price-compare" id="pp-compare-price" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>MRP {{ current_variant.compare_at_price | money }}</span>
                <span class="pp-price-save-text" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
                  You save <span id="pp-save-amount">{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | minus: current_variant.price | money }}{% endif %}</span> (<span id="pp-save-pct">{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}{% endif %}</span>%)
                </span>
                {% unless current_variant.compare_at_price > current_variant.price %}
                  {% assign dummy_compare = current_variant.price | times: 1.10 | round %}
                  {% assign dummy_save = dummy_compare | minus: current_variant.price %}
                  <span class="pp-price-compare" id="pp-compare-price">MRP {{ dummy_compare | money }}</span>
                  <span class="pp-price-save-text">You save <span id="pp-save-amount">{{ dummy_save | money }}</span> (<span id="pp-save-pct">9</span>%)</span>
                {% endunless %}
              </div>
            </div>

            <div class="pp-desc-section">
              <div class="pp-desc-content" id="pp-desc-content">
                {%- if product.description != blank -%}
                  {{ product.description }}
                {%- else -%}
                  <p>Handcrafted in 18K BIS Hallmarked Gold with VS-certified natural diamonds. Designed for timeless elegance and everyday luxury. Every diamond is ethically sourced and expertly set by master craftsmen. Perfect for weddings, anniversaries, celebrations, and daily luxury wear. Comes with lifetime maintenance, insured shipping, and authenticity certificate.</p>
                {%- endif -%}
              </div>
              <button type="button" class="pp-read-more-btn" id="pp-read-more-btn" aria-expanded="false" style="display: none;">
                <span class="pp-read-more-text">Read More</span>
                <svg class="pp-read-more-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l7 7 7-7"/></svg>
              </button>
            </div>

          {%- when 'variant_picker' -%}
            {% form 'product', product, id: 'pp-product-form' %}
              <input type="hidden" name="id" id="pp-variant-id" value="{{ current_variant.id }}">
              <input type="hidden" name="quantity" class="pp-qty-val" value="1">
              
              {%- unless product.has_only_default_variant -%}
                <div class="pp-variants">
                  {%- for option in product.options_with_values -%}
                    <div class="pp-option-group" data-option-index="{{ forloop.index0 }}">
                      <label class="pp-option-label">{{ option.name }}</label>
                      <div class="pp-option-values">
                        {%- for value in option.values -%}
                          <button type="button" class="pp-opt-btn {% if option.selected_value == value %}is-active{% endif %}" data-value="{{ value | escape }}">
                            {{ value }}
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <!-- Fallback to display luxury options matching Image 1 when product options are not set -->
                <div class="pp-variants">
                  <div class="pp-option-group">
                    <label class="pp-option-label">Gold Purity</label>
                    <div class="pp-option-values">
                      <button type="button" class="pp-opt-btn is-active">18K</button>
                      <button type="button" class="pp-opt-btn">14K</button>
                      <button type="button" class="pp-opt-btn">22K</button>
                    </div>
                  </div>
                  <div class="pp-option-group">
                    <label class="pp-option-label">Diamond Quality</label>
                    <div class="pp-option-values">
                      <button type="button" class="pp-opt-btn is-active">G-VS</button>
                      <button type="button" class="pp-opt-btn">F-VVS</button>
                      <button type="button" class="pp-opt-btn">E-VVS</button>
                    </div>
                  </div>
                </div>
              {%- endunless -%}
            {% endform %}

          {%- when 'buy_buttons' -%}
            <div class="pp-actions-row">
              <button type="submit" form="pp-product-form" class="pp-btn-add">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                ADD TO CART
              </button>
              <button type="button" class="pp-btn-buy" id="pp-buy-now">BUY NOW</button>
            </div>


        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="pp-bottom-showcase" id="details">
    <div class="pp-bottom-showcase-grid">
      <!-- LEFT BOX: PRODUCT DETAILS & SPECS -->
      <div class="pp-bottom-card pp-bottom-left-card">
        <h3 class="pp-bottom-title">PRODUCT DETAILS</h3>
        <p class="pp-bottom-desc">{{ product.description | strip_html | default: 'A timeless expression of elegance, this 18K yellow gold necklace features a classic figaro chain adorned with brilliant diamonds. Perfect for special occasions and everyday luxury.' }}</p>
        
        <div class="pp-specs-list">
          <div class="pp-spec-row">
            <span class="pp-spec-lbl">Metal</span>
            <span class="pp-spec-val">18K Yellow Gold</span>
          </div>
          <div class="pp-spec-row">
            <span class="pp-spec-lbl">Gross Weight</span>
            <span class="pp-spec-val">16.350 gms</span>
          </div>
          <div class="pp-spec-row">
            <span class="pp-spec-lbl">Diamond Weight</span>
            <span class="pp-spec-val">1.75 cts</span>
          </div>
          <div class="pp-spec-row">
            <span class="pp-spec-lbl">Diamond Quality</span>
            <span class="pp-spec-val">G-VS</span>
          </div>
          <div class="pp-spec-row">
            <span class="pp-spec-lbl">Certification</span>
            <span class="pp-spec-val">BIS Hallmarked</span>
          </div>
        </div>

        <a href="#details" class="pp-view-more-link">
          <span>View More Details</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- RIGHT BOX: ACCORDIONS -->
      <div class="pp-bottom-card pp-bottom-right-card">
        <div class="pp-acc-item is-open">
          <button class="pp-acc-header" type="button" aria-expanded="true">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #D4AF37)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <span class="pp-acc-title">CERTIFICATION & ASSURANCE</span>
            </span>
            <svg class="pp-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            <p>Every jewellery piece is accompanied by a physical certificate of authenticity from IGI / SGL and is 100% BIS Hallmarked for guaranteed gold purity and quality assurance.</p>
          </div>
        </div>

        <div class="pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #D4AF37)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span class="pp-acc-title">SHIPPING & RETURNS</span>
            </span>
            <svg class="pp-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content" style="display:none;">
            <p>We offer Free Insured Express Delivery nationwide across India. Enjoy our hassle-free 15-day money-back guarantee with complimentary doorstep pickup if you are not 100% delighted.</p>
          </div>
        </div>

        <div class="pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #D4AF37)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/><path d="M9 12l2 2 4-4"/></svg>
              <span class="pp-acc-title">CARE INSTRUCTIONS</span>
            </span>
            <svg class="pp-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content" style="display:none;">
            <p>Store your diamond jewellery in its original lined box or suede pouch. Clean gently using lukewarm water, mild soap, and a soft brush. Keep away from perfumes and harsh chemicals.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- You May Also Like Product Recommendations (Shopify Native AI & Luxury Fallback without Bounding Box) -->
  <product-recommendations class="pp-recommendations-section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
    <div class="pp-section-header-wrap">
      <span class="pp-section-sub">CURATED PAIRINGS</span>
      <h2 class="pp-section-title">You May Also Like</h2>
    </div>

    <div class="pp-related-carousel-container">
      <button type="button" class="pp-rel-arrow pp-rel-prev" aria-label="Previous Products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="pp-related-grid" id="pp-related-grid">
        {% assign rel_count = 0 %}
        {% if recommendations.performed and recommendations.products_count > 0 %}
          {% for rel_product in recommendations.products %}
            {% if rel_count < 4 %}
              {% assign rel_count = rel_count | plus: 1 %}
              <a href="{{ rel_product.url }}" class="pp-related-item-card">
                <div class="pp-related-img-wrap">
                  {% if rel_product.featured_image %}
                    <img src="{{ rel_product.featured_image | image_url: width: 400 }}" alt="{{ rel_product.title | escape }}" width="400" height="400" loading="lazy">
                  {% else %}
                    <img src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Jewelry" width="400" height="400" loading="lazy">
                  {% endif %}
                </div>
                <div class="pp-related-info">
                  <h3 class="pp-related-item-title">{{ rel_product.title }}</h3>
                  <div class="pp-related-price">{{ rel_product.price | money | replace: '$', '₹' | replace: 'USD', '₹' | replace: '.00', '' }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        {% else %}
          {% assign related_collection = collections['frontpage'] | default: collections.all %}
          {% for rel_product in related_collection.products %}
            {% unless rel_product.id == product.id %}
              {% if rel_count < 4 %}
                {% assign rel_count = rel_count | plus: 1 %}
                <a href="{{ rel_product.url }}" class="pp-related-item-card">
                  <div class="pp-related-img-wrap">
                    {% if rel_product.featured_image %}
                      <img src="{{ rel_product.featured_image | image_url: width: 400 }}" alt="{{ rel_product.title | escape }}" width="400" height="400" loading="lazy">
                    {% else %}
                      <img src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Jewelry" width="400" height="400" loading="lazy">
                    {% endif %}
                  </div>
                  <div class="pp-related-info">
                    <h3 class="pp-related-item-title">{{ rel_product.title }}</h3>
                    <div class="pp-related-price">{{ rel_product.price | money | replace: '$', '₹' | replace: 'USD', '₹' | replace: '.00', '' }}</div>
                  </div>
                </a>
              {% endif %}
            {% endunless %}
          {% endfor %}
        {% endif %}

        {% if rel_count < 4 %}
          {% assign missing_count = 4 | minus: rel_count %}
          {% for i in (1..missing_count) %}
            {% assign demo_index = i | plus: rel_count %}
            {% if demo_index == 1 %}
              {% assign fallback_title = "18K Diamond Pendant Set" %}
              {% assign fallback_price = "₹1,45,900" %}
              {% assign fallback_img = "best_seller_pendant.png" %}
            {% elsif demo_index == 2 %}
              {% assign fallback_title = "Gold & Diamond Earrings" %}
              {% assign fallback_price = "₹89,900" %}
              {% assign fallback_img = "best_seller_earrings.png" %}
            {% elsif demo_index == 3 %}
              {% assign fallback_title = "Classic Gold Ring" %}
              {% assign fallback_price = "₹59,900" %}
              {% assign fallback_img = "best_seller_ring.png" %}
            {% else %}
              {% assign fallback_title = "Diamond Bracelet" %}
              {% assign fallback_price = "₹1,25,900" %}
              {% assign fallback_img = "best_seller_bracelet.png" %}
            {% endif %}
            <div class="pp-related-item-card">
              <div class="pp-related-img-wrap">
                <img src="{{ fallback_img | asset_url }}" alt="{{ fallback_title }}" width="400" height="400" loading="lazy">
              </div>
              <div class="pp-related-info">
                <h3 class="pp-related-item-title">{{ fallback_title }}</h3>
                <div class="pp-related-price">{{ fallback_price }}</div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <button type="button" class="pp-rel-arrow pp-rel-next" aria-label="Next Products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </product-recommendations>
</div>

<script id="pp-variants-json" type="application/json">
  {{ product.variants | json }}
</script>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --pp-primary: #013F3E;
    --pp-primary-hover: #012B2A;
    --pp-accent: #D4AF37;
    --pp-accent-hover: #C29D2C;
    --pp-bg-light: #FAF7F0;
    --pp-border: #EAE0D5;
    --pp-text: #222222;
    --pp-text-muted: #666666;
    --pp-font-serif: 'Cormorant Garamond', Georgia, serif;
    --pp-font-sans: 'Inter', -apple-system, sans-serif;
  }

  /* ==========================================================================
     1. BREADCRUMBS NAVIGATION
     ========================================================================== */
  .pp-breadcrumb-nav {
    width: 100%;
    margin-top: 16px;
    margin-bottom: 24px;
    font-family: var(--pp-font-sans);
  }
  .pp-breadcrumb-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .pp-breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap !important;
    white-space: normal !important;
    overflow-x: visible !important;
    gap: 6px 10px !important;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--pp-text-muted);
  }
  .pp-breadcrumb-item {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap !important;
  }
  .pp-breadcrumb-link {
    color: var(--pp-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }
  .pp-breadcrumb-link:hover {
    color: var(--pp-primary);
    text-decoration: underline;
  }
  .pp-home-icon { color: var(--pp-accent); display: flex; align-items: center; }
  .pp-breadcrumb-separator { display: inline-flex; align-items: center; color: #CCCCCC; margin-right: 10px; flex-shrink: 0; }
  .pp-breadcrumb-current { color: var(--pp-primary); font-weight: 600; word-break: break-word; }

  /* ==========================================================================
     2. MAIN PRODUCT CONTAINER & GRID
     ========================================================================== */
  .pp-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1240px;
    margin: 0 auto 50px auto;
    padding: 0 20px;
    font-family: var(--pp-font-sans);
    color: var(--pp-text);
  }
  @media screen and (min-width: 992px) {
    .pp-container {
      grid-template-columns: 540px 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* ==========================================================================
     3. LEFT COLUMN: LUXURY GALLERY (Constrained 540px Square)
     ========================================================================== */
  .pp-left {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
  }
  @media screen and (min-width: 992px) {
