    background: transparent !important;
    transform: scale(0.92);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
    cursor: default !important;
    margin: auto !important;
  }
  .pp-zoom-overlay.is-active #pp-zoom-img { transform: scale(1) !important; }

  @media screen and (max-width: 767px) {
    .pp-zoom-overlay { padding: max(20px, env(safe-area-inset-top, 20px)) 16px max(20px, env(safe-area-inset-bottom, 20px)) !important; box-sizing: border-box !important; }
    .pp-zoom-close { position: fixed !important; top: max(16px, env(safe-area-inset-top, 16px)) !important; right: max(16px, env(safe-area-inset-right, 16px)) !important; width: 44px !important; height: 44px !important; z-index: 1000000 !important; box-shadow: 0 4px 16px rgba(0,0,0,0.15) !important; }
    #pp-zoom-img { border-radius: 16px !important; max-width: 95vw !important; max-height: 82vh !important; width: auto !important; height: auto !important; object-fit: contain !important; margin: auto !important; }
  }

  /* Responsive Mobile Tweaks */
