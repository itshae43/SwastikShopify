{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="premium-product" data-product-id="{{ product.id }}" data-url="{{ product.url }}">
  {% render 'breadcrumb', product: product, collection: collection %}

  <div class="pp-container">
    
    <!-- LEFT COLUMN -->
    <div class="pp-left">
      <!-- Gallery -->
      <div class="pp-gallery">
        <div class="pp-main-image-wrap">

          <button class="pp-nav-btn pp-nav-prev" aria-label="Previous">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          
          <div class="pp-main-img-container">
            {% if product.featured_image %}
              <img id="pp-main-image" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" height="1000">
            {% else %}
              <img id="pp-main-image" src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Luxury Diamond Jewelry" width="1000" height="1000">
            {% endif %}
          </div>
          
          <button class="pp-nav-btn pp-nav-next" aria-label="Next">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
          
          <button class="pp-fullscreen-btn" aria-label="Fullscreen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
        </div>
        
        <!-- Thumbnails Horizontal Carousel Below Main Image -->
        <div class="pp-thumbnails-section">
          <button class="pp-thumb-nav-btn pp-thumb-nav-prev" type="button" aria-label="Previous Thumbnails">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>

          {% if product.images.size > 1 %}
            <div class="pp-thumbnails-wrapper">
              <div class="pp-thumbnails">
                {% for image in product.images %}
                  <div class="pp-thumb-item {% if forloop.first %}is-active{% endif %}" data-image="{{ image | image_url: width: 1000 }}">
                    <div class="pp-thumb-img">
                      <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | escape }}" width="180" height="180">
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <div class="pp-thumbnails-wrapper">
              <div class="pp-thumbnails">
                {% if product.featured_image %}
                  <div class="pp-thumb-item is-active" data-image="{{ product.featured_image | image_url: width: 1000 }}">
                    <div class="pp-thumb-img">
                      <img src="{{ product.featured_image | image_url: width: 180 }}" alt="{{ product.title | escape }}" width="180" height="180">
                    </div>
                  </div>
                {% endif %}
                {% assign luxury_fallbacks = "best_seller_pendant.png,best_seller_earrings.png,best_seller_ring.png,best_seller_bracelet.png" | split: "," %}
                {% for img_name in luxury_fallbacks %}
                  {% unless product.featured_image and forloop.first %}
                    <div class="pp-thumb-item {% if product.featured_image == blank and forloop.first %}is-active{% endif %}" data-image="{{ img_name | asset_url }}">
                      <div class="pp-thumb-img">
                        <img src="{{ img_name | asset_url }}" alt="Luxury Jewelry Thumbnail" width="180" height="180">
                      </div>
                    </div>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <button class="pp-thumb-nav-btn pp-thumb-nav-next" type="button" aria-label="Next Thumbnails">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>


    </div>

    <!-- RIGHT COLUMN -->
    <div class="pp-right">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="pp-header-block">
              <h1 class="pp-title">{{ product.title }}</h1>
              

              
              <div class="pp-meta-row">
                <div class="pp-reviews">
                  <div class="pp-stars">
                    {% for i in (1..5) %}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="#F5C518"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    {% endfor %}
                  </div>
                  <span class="pp-review-text">4.8 (128 Reviews)</span>
                </div>
                <div class="pp-sku-wrap">
                  <span class="pp-sku-label">SKU:</span>
                  <span class="pp-sku-val" id="pp-sku">{{ current_variant.sku | default: 'SWRK-NC-1024' }}</span>
                </div>
              </div>
            </div>

          {%- when 'price' -%}
            <div class="pp-price-box">
              <div class="pp-price-box-top">
                <span class="pp-price-current" id="pp-price">{{ current_variant.price | money }}</span>
                <span class="pp-price-tax-label">(Incl. of all taxes)</span>
              </div>
              <div class="pp-price-box-bottom">
                <span class="pp-price-compare" id="pp-compare-price" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>MRP {{ current_variant.compare_at_price | money }}</span>
                <span class="pp-price-save-text" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
                  You save <span id="pp-save-amount">{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | minus: current_variant.price | money }}{% endif %}</span> (<span id="pp-save-pct">{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}{% endif %}</span>%)
                </span>
                {% unless current_variant.compare_at_price > current_variant.price %}
                  {% assign dummy_compare = current_variant.price | times: 1.10 | round %}
                  {% assign dummy_save = dummy_compare | minus: current_variant.price %}
                  <span class="pp-price-compare" id="pp-compare-price">MRP {{ dummy_compare | money }}</span>
                  <span class="pp-price-save-text">You save <span id="pp-save-amount">{{ dummy_save | money }}</span> (<span id="pp-save-pct">9</span>%)</span>
                {% endunless %}
              </div>
            </div>

          {%- when 'variant_picker' -%}
            {% form 'product', product, id: 'pp-product-form' %}
              <input type="hidden" name="id" id="pp-variant-id" value="{{ current_variant.id }}">
              <input type="hidden" name="quantity" class="pp-qty-val" value="1">
              
              {%- unless product.has_only_default_variant -%}
                <div class="pp-variants">
                  {%- for option in product.options_with_values -%}
                    <div class="pp-option-group" data-option-index="{{ forloop.index0 }}">
                      <label class="pp-option-label">{{ option.name }}</label>
                      <div class="pp-option-values">
                        {%- assign opt_vals = option.values -%}
                        {%- assign name_dc = option.name | downcase -%}
                        {%- if name_dc contains 'purity' or name_dc contains 'gold' or name_dc contains 'carat' or name_dc contains 'karat' -%}
                          {%- assign opt_vals = option.values | sort_natural -%}
                        {%- endif -%}
                        {%- for value in opt_vals -%}
                          <button type="button" class="pp-opt-btn {% if option.selected_value == value %}is-active{% endif %}" data-value="{{ value | escape }}">
                            {{ value }}
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <!-- Fallback to display luxury options matching Image 1 when product options are not set -->
                <div class="pp-variants">
                  <div class="pp-option-group">
                    <label class="pp-option-label">Gold Purity</label>
                    <div class="pp-option-values">
                      <button type="button" class="pp-opt-btn">14K</button>
                      <button type="button" class="pp-opt-btn is-active">18K</button>
                      <button type="button" class="pp-opt-btn">22K</button>
                    </div>
                  </div>
                  <div class="pp-option-group">
                    <label class="pp-option-label">Diamond Quality</label>
                    <div class="pp-option-values">
                      <button type="button" class="pp-opt-btn is-active">G-VS</button>
                      <button type="button" class="pp-opt-btn">F-VVS</button>
                      <button type="button" class="pp-opt-btn">E-VVS</button>
                    </div>
                  </div>
                </div>
              {%- endunless -%}
            {% endform %}

          {%- when 'buy_buttons' -%}
            <div class="pp-actions-container">
              <!-- ROW 1: QUANTITY + ADD TO CART -->
              <div class="pp-actions-top-row">
                <div class="pp-qty-widget">
                  <button type="button" class="pp-qty-btn pp-qty-minus" aria-label="Decrease quantity">−</button>
                  <input type="number" name="quantity" value="1" min="1" class="pp-qty-input" form="pp-product-form" readonly>
                  <button type="button" class="pp-qty-btn pp-qty-plus" aria-label="Increase quantity">+</button>
                </div>
                <button type="submit" form="pp-product-form" class="pp-btn-add">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  <span>ADD TO CART</span>
                </button>
              </div>

              <!-- ROW 2: BUY NOW WITH ARROW -->
              <button type="button" class="pp-btn-buy" id="pp-buy-now">
                <span class="pp-btn-spacer"></span>
                <span class="pp-btn-text">BUY NOW</span>
                <svg class="pp-btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>


        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="pp-bottom-showcase" id="details">
    <div class="pp-bottom-showcase-grid">
      
      <!-- 1. ABOUT THIS JEWELLERY CARD (Clean & Compact) -->
      <div class="pp-bottom-card pp-about-card">
        <div class="pp-about-header">
          <span class="pp-about-title">ABOUT THIS JEWELLERY</span>
        </div>
        <div class="pp-about-content">
          <div class="pp-about-desc">
            {%- if product.description != blank -%}
              <div class="pp-about-short">{{ product.description }}</div>
            {%- else -%}
              <p class="pp-about-short">An elegant teardrop pendant perfect for any occasion. Handcrafted in 18K yellow gold and adorned with naturally brilliant diamonds, every detail is designed to celebrate love and beauty.</p>
            {%- endif -%}
            <p class="pp-about-more" style="display: none;">Each masterpiece is individually inspected by master gemologists to ensure exceptional brilliance, fire, and structural durability. Designed to sit comfortably for everyday wear while making an extraordinary statement of luxury that lasts a lifetime.</p>
          </div>
          <div class="pp-about-btn-wrap">
            <button type="button" class="pp-read-more-btn" id="pp-read-more-toggle">
              <span class="pp-rm-text">Read more</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 2. SEGMENTED CONTROL & INFORMATION CARD (Figma Spec 1:1) -->
      <div class="pp-tabs-card pp-segmented-section">
        <!-- Top Segmented Control (Height 60px, Inset 4px, Radius 18px) -->
        <div class="pp-segmented-control">
          <button type="button" class="pp-tab-btn pp-segment-btn is-active" data-target="tab-details">
            <svg class="pp-tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9l4-6z"/><path d="M11 3l4 6-4 12"/><path d="M13 3l-4 6 4 12"/><path d="M2 9h20"/></svg>
            <span class="pp-segment-text">Product Details</span>
          </button>
          <button type="button" class="pp-tab-btn pp-segment-btn" data-target="tab-price">
            <svg class="pp-tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span class="pp-segment-text">Price Breakdown</span>
          </button>
        </div>

        <!-- Card Below: Tab 1 (Product Details) -->
        <div class="pp-info-card pp-tab-body is-active" id="tab-details">
          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              <span class="pp-row-label">Metal</span>
            </div>
            <span class="pp-row-value">18K Yellow Gold</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="M2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
              <span class="pp-row-label">Gross Weight</span>
            </div>
            <span class="pp-row-value">16.350 gms</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9l4-6z"/><path d="M11 3l4 6-4 12"/><path d="M13 3l-4 6 4 12"/><path d="M2 9h20"/></svg>
              <span class="pp-row-label">Diamond Weight</span>
            </div>
            <span class="pp-row-value">1.75 cts</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
              <span class="pp-row-label">Diamond Quality</span>
            </div>
            <span class="pp-row-value">G–VS</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <span class="pp-row-label">Certification</span>
            </div>
            <span class="pp-row-value">BIS Hallmarked</span>
          </div>
          <div class="pp-row-divider"></div>

          <!-- Trust Banner -->
          <div class="pp-trust-banner">
            <svg class="pp-tb-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0E4A43" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            <span class="pp-tb-text">All our jewellery is made with conflict-free diamonds and certified for your peace of mind.</span>
          </div>
        </div>

        <!-- Card Below: Tab 2 (Price Breakdown) -->
        <div class="pp-info-card pp-tab-body" id="tab-price" style="display: none;">
          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
              <span class="pp-row-label">Gold Value (18K)</span>
            </div>
            <span class="pp-row-value">₹85,400</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9l4-6z"/><path d="M11 3l4 6-4 12"/><path d="M13 3l-4 6 4 12"/><path d="M2 9h20"/></svg>
              <span class="pp-row-label">Diamond Value (1.75 cts)</span>
            </div>
            <span class="pp-row-value">₹42,500</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              <span class="pp-row-label">Making Charges</span>
            </div>
            <span class="pp-row-value">₹13,500</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              <span class="pp-row-label">GST (3%)</span>
            </div>
            <span class="pp-row-value">₹4,500</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row pp-total-row">
            <div class="pp-row-left">
              <svg class="pp-row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span class="pp-row-label" style="font-weight: 600; color: #0E4A43;">Total Price</span>
            </div>
            <span class="pp-row-value" style="font-weight: 700; color: #0E4A43; font-size: 16px;">{{ current_variant.price | money }}</span>
          </div>
          <div class="pp-row-divider"></div>

          <!-- Trust Banner in Price Tab too -->
          <div class="pp-trust-banner">
            <svg class="pp-tb-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0E4A43" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            <span class="pp-tb-text">All our jewellery is made with conflict-free diamonds and certified for your peace of mind.</span>
          </div>
        </div>
      </div>

      <!-- 3. COLLAPSIBLE ACCORDION ITEMS (4 Distinct Cards matching Image 1 & 2) -->
      <div class="pp-accordions-group">
        <!-- 1. CERTIFICATION & ASSURANCE -->
        <div class="pp-bottom-card pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #D4AF37)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <span class="pp-acc-title">CERTIFICATION & ASSURANCE</span>
            </span>
            <svg class="pp-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            <p>Every jewellery piece is accompanied by a physical certificate of authenticity from IGI / SGL and is 100% BIS Hallmarked for guaranteed gold purity and quality assurance.</p>
          </div>
        </div>

        <!-- 2. SHIPPING & RETURNS -->
        <div class="pp-bottom-card pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #D4AF37)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span class="pp-acc-title">SHIPPING & RETURNS</span>
            </span>
            <svg class="pp-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            <p>We offer Free Insured Express Delivery nationwide across India. Enjoy our hassle-free 15-day money-back guarantee with complimentary doorstep pickup if you are not 100% delighted.</p>
          </div>
        </div>

        <!-- 3. CARE INSTRUCTIONS -->
        <div class="pp-bottom-card pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #D4AF37)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/><path d="M9 12l2 2 4-4"/></svg>
              <span class="pp-acc-title">CARE INSTRUCTIONS</span>
            </span>
            <svg class="pp-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            <p>Store your diamond jewellery in its original lined box or suede pouch. Clean gently using lukewarm water, mild soap, and a soft brush. Keep away from perfumes and harsh chemicals.</p>
          </div>
        </div>

        <!-- 4. ETHICAL CRAFTSMANSHIP -->
        <div class="pp-bottom-card pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #D4AF37)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span class="pp-acc-title">ETHICAL CRAFTSMANSHIP</span>
            </span>
            <svg class="pp-acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            <p>Every creation is sustainably crafted using 100% recycled gold and conflict-free diamonds sourced from ethical mines adhering to the highest global labor and environmental standards.</p>
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <!-- You May Also Like Product Recommendations (Shopify Native AI & Luxury Fallback without Bounding Box) -->
  <product-recommendations class="pp-recommendations-section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
    <div class="pp-section-header-wrap">
      <span class="pp-section-sub">CURATED PAIRINGS</span>
      <h2 class="pp-section-title">You May Also Like</h2>
    </div>

    <div class="pp-related-carousel-container">
      <button type="button" class="pp-rel-arrow pp-rel-prev" aria-label="Previous Products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="pp-related-grid" id="pp-related-grid">
        {% assign rel_count = 0 %}
        {% if recommendations.performed and recommendations.products_count > 0 %}
          {% for rel_product in recommendations.products %}
            {% if rel_count < 4 %}
              {% assign rel_count = rel_count | plus: 1 %}
              <a href="{{ rel_product.url }}" class="pp-related-item-card">
                <div class="pp-related-img-wrap">
                  {% if rel_product.featured_image %}
                    <img src="{{ rel_product.featured_image | image_url: width: 400 }}" alt="{{ rel_product.title | escape }}" width="400" height="400" loading="lazy">
                  {% else %}
                    <img src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Jewelry" width="400" height="400" loading="lazy">
                  {% endif %}
                </div>
                <div class="pp-related-info">
                  <h3 class="pp-related-item-title">{{ rel_product.title }}</h3>
                  <div class="pp-related-price">{{ rel_product.price | money | replace: '$', '₹' | replace: 'USD', '₹' | replace: '.00', '' }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        {% else %}
          {% assign related_collection = collections['frontpage'] | default: collections.all %}
          {% for rel_product in related_collection.products %}
            {% unless rel_product.id == product.id %}
              {% if rel_count < 4 %}
                {% assign rel_count = rel_count | plus: 1 %}
                <a href="{{ rel_product.url }}" class="pp-related-item-card">
                  <div class="pp-related-img-wrap">
                    {% if rel_product.featured_image %}
                      <img src="{{ rel_product.featured_image | image_url: width: 400 }}" alt="{{ rel_product.title | escape }}" width="400" height="400" loading="lazy">
                    {% else %}
                      <img src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Jewelry" width="400" height="400" loading="lazy">
                    {% endif %}
                  </div>
                  <div class="pp-related-info">
                    <h3 class="pp-related-item-title">{{ rel_product.title }}</h3>
                    <div class="pp-related-price">{{ rel_product.price | money | replace: '$', '₹' | replace: 'USD', '₹' | replace: '.00', '' }}</div>
                  </div>
                </a>
              {% endif %}
            {% endunless %}
          {% endfor %}
        {% endif %}

        {% if rel_count < 4 %}
          {% assign missing_count = 4 | minus: rel_count %}
          {% for i in (1..missing_count) %}
            {% assign demo_index = i | plus: rel_count %}
            {% if demo_index == 1 %}
              {% assign fallback_title = "18K Diamond Pendant Set" %}
              {% assign fallback_price = "₹1,45,900" %}
              {% assign fallback_img = "best_seller_pendant.png" %}
            {% elsif demo_index == 2 %}
              {% assign fallback_title = "Gold & Diamond Earrings" %}
              {% assign fallback_price = "₹89,900" %}
              {% assign fallback_img = "best_seller_earrings.png" %}
            {% elsif demo_index == 3 %}
              {% assign fallback_title = "Classic Gold Ring" %}
              {% assign fallback_price = "₹59,900" %}
              {% assign fallback_img = "best_seller_ring.png" %}
            {% else %}
              {% assign fallback_title = "Diamond Bracelet" %}
              {% assign fallback_price = "₹1,25,900" %}
              {% assign fallback_img = "best_seller_bracelet.png" %}
            {% endif %}
            <div class="pp-related-item-card">
              <div class="pp-related-img-wrap">
                <img src="{{ fallback_img | asset_url }}" alt="{{ fallback_title }}" width="400" height="400" loading="lazy">
              </div>
              <div class="pp-related-info">
                <h3 class="pp-related-item-title">{{ fallback_title }}</h3>
                <div class="pp-related-price">{{ fallback_price }}</div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <button type="button" class="pp-rel-arrow pp-rel-next" aria-label="Next Products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </product-recommendations>
</div>

<script id="pp-variants-json" type="application/json">
  {{ product.variants | json }}
</script>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --pp-primary: #013F3E;
    --pp-primary-hover: #012B2A;
    --pp-accent: #D4AF37;
    --pp-accent-hover: #C29D2C;
    --pp-bg-light: #FAF7F0;
    --pp-border: #EAE0D5;
    --pp-text: #222222;
    --pp-text-muted: #666666;
    --pp-font-serif: 'Cormorant Garamond', Georgia, serif;
    --pp-font-sans: 'Inter', -apple-system, sans-serif;
  }

  /* ==========================================================================
     1. BREADCRUMBS NAVIGATION
     ========================================================================== */
  .pp-breadcrumb-nav {
    width: 100%;
    margin-top: 16px;
    margin-bottom: 24px;
    font-family: var(--pp-font-sans);
  }
  .pp-breadcrumb-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .pp-breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap !important;
    white-space: normal !important;
    overflow-x: visible !important;
    gap: 6px 10px !important;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--pp-text-muted);
  }
  .pp-breadcrumb-item {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap !important;
  }
  .pp-breadcrumb-link {
    color: var(--pp-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }
  .pp-breadcrumb-link:hover {
    color: var(--pp-primary);
    text-decoration: underline;
  }
  .pp-home-icon { color: var(--pp-accent); display: flex; align-items: center; }
  .pp-breadcrumb-separator { display: inline-flex; align-items: center; color: #CCCCCC; margin-right: 10px; flex-shrink: 0; }
  .pp-breadcrumb-current { color: var(--pp-primary); font-weight: 600; word-break: break-word; }

  /* ==========================================================================
     2. MAIN PRODUCT CONTAINER & GRID
     ========================================================================== */
  .pp-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1240px;
    margin: 0 auto 50px auto;
    padding: 0 20px;
    font-family: var(--pp-font-sans);
    color: var(--pp-text);
  }
  @media screen and (min-width: 992px) {
    .pp-container {
      grid-template-columns: 540px 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* ==========================================================================
     3. LEFT COLUMN: LUXURY GALLERY (Constrained 540px Square)
     ========================================================================== */
  .pp-left {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
  }
  @media screen and (min-width: 992px) {
    .pp-left {
      position: sticky;
      top: 40px;
    }
  }

  .pp-gallery { width: 100%; display: flex; flex-direction: column; }

  .pp-main-image-wrap {
    position: relative;
    width: 100%;
    max-width: 540px;
    max-height: 540px;
    aspect-ratio: 1 / 1;
    background: #FAF7F0;
    border: 1px solid var(--pp-border);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 35px rgba(1, 63, 62, 0.04);
    margin: 0 auto;
  }
  .pp-main-img-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 0; }
  /* #pp-main-image styled below in zoom overlay section */


  .pp-nav-btn {
    position: absolute; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; border-radius: 50%;
    background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.06); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; color: #222222; transition: all 0.25s ease;
  }
  .pp-nav-btn:hover { background: var(--pp-primary); color: #ffffff; border-color: var(--pp-primary); transform: translateY(-50%) scale(1.05); }
  .pp-nav-prev { left: 16px; }
  .pp-nav-next { right: 16px; }

  .pp-fullscreen-btn {
    position: absolute; bottom: 16px; right: 16px; width: 40px; height: 40px; border-radius: 50%;
    background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.06); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; color: #222222; transition: all 0.25s ease;
  }
  .pp-fullscreen-btn:hover { transform: scale(1.08); color: var(--pp-primary); }

  /* Thumbnails Carousel */
  .pp-thumbnails-section { display: flex; align-items: center; gap: 12px; margin-top: 16px; width: 100%; max-width: 540px; position: relative; }
  .pp-thumb-nav-btn {
    width: 36px; height: 36px; border-radius: 50%; background: #ffffff; border: 1px solid var(--pp-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; color: #222222; transition: all 0.2s ease;
  }
  .pp-thumb-nav-btn:hover { background: var(--pp-primary); color: #ffffff; border-color: var(--pp-primary); }
  .pp-thumbnails-wrapper { flex: 1; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; -ms-overflow-style: none; padding: 4px 2px; }
  .pp-thumbnails-wrapper::-webkit-scrollbar { display: none; }
  .pp-thumbnails { display: flex; gap: 12px; width: max-content; }
  .pp-thumb-item { flex: 0 0 76px; width: 76px; height: 76px; border-radius: 12px; cursor: pointer; transition: transform 0.2s ease; }
  .pp-thumb-item:hover { transform: translateY(-2px); }
  .pp-thumb-img {
    width: 100%; height: 100%; border-radius: 12px; background: #FAF7F0; border: 2px solid #EAE0D5;
    overflow: hidden; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; padding: 0;
  }
  .pp-thumb-img img, .pp-thumb-img svg { width: 100%; height: 100%; object-fit: cover; }
  .pp-thumb-item.is-active .pp-thumb-img { border-color: #C89234 !important; box-shadow: 0 6px 16px rgba(200, 146, 52, 0.28) !important; transform: scale(1.02); }

  /* ==========================================================================
     4. RIGHT COLUMN: EXACT LUXURY TYPOGRAPHY & SPACING SCALE
     ========================================================================== */
  .pp-right {
    display: flex;
    flex-direction: column;
    gap: 0; /* Controlled precisely by luxury margins below */
    font-family: var(--pp-font-sans);
  }

  .pp-bestseller-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #C89234;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .pp-header-block {
    display: flex;
    flex-direction: column;
  }

  /* Product Title: Clean, premium Inter sans-serif, bold weight, readable & professional */
  .pp-title {
    font-family: var(--pp-font-sans);
    font-size: 38px;
    font-weight: 700;
    color: var(--pp-primary);
    line-height: 1.25;
    margin: 0 0 12px 0; /* Title -> Rating: 12px */
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Rating & Meta Row: Inter, 14px, Weight 500, Line Height 1.5 */
  .pp-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--pp-text-muted);
    margin-bottom: 20px; /* Rating -> Price: 20px */
    padding-bottom: 20px;
    border-bottom: 1px solid var(--pp-border);
  }
  .pp-reviews { display: flex; align-items: center; gap: 8px; }
  .pp-stars { display: flex; gap: 3px; color: #F59E0B; }
  .pp-review-text { font-weight: 600; color: #222222; }
  .pp-sku-wrap { color: var(--pp-text-muted); }
  .pp-sku-label { font-weight: 600; color: #444444; }

  /* Price: Inter, 40px, Weight 700, Line Height 1.1 */
  .pp-price-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px; /* Price -> Description: 24px */
    padding-bottom: 24px;
    border-bottom: 1px solid var(--pp-border);
  }
  .pp-price-box-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pp-price-current {
    font-family: var(--pp-font-sans);
    font-size: 40px;
    font-weight: 700;
    color: var(--pp-primary);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .pp-price-tax-label { font-size: 14px; font-weight: 500; color: var(--pp-text-muted); }
  .pp-price-box-bottom { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; font-size: 14px; }
  .pp-price-compare { color: #888888; text-decoration: line-through; font-weight: 500; }
  .pp-price-save-text { color: #C87A1E; font-weight: 700; background: #FFF4E6; padding: 4px 10px; border-radius: 6px; font-size: 13px; }

  /* Variants Block */
  .pp-variants {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 32px; /* Variants -> CTA: 32px */
    padding-bottom: 32px;
    border-bottom: 1px solid var(--pp-border);
  }
  .pp-option-group { display: flex; flex-direction: column; gap: 12px; }
  /* Section Heading: Inter, 16px, Weight 600, Line Height 1.4 */
  .pp-option-label {
    font-family: var(--pp-font-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: #222222;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pp-option-values { display: flex; flex-wrap: wrap; gap: 12px; }
  /* Product Meta (Option Buttons): Inter, 14px, Weight 500, Line Height 1.5 */
  .pp-opt-btn {
    background: #FFFFFF; border: 1.5px solid #DED8CE; border-radius: 10px;
    padding: 12px 24px; font-family: var(--pp-font-sans); font-size: 14px; font-weight: 500; line-height: 1.5;
    color: #333333; cursor: pointer; transition: all 0.25s ease; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    user-select: none; -webkit-user-select: none;
  }
  .pp-opt-btn:hover { border-color: var(--pp-primary); color: var(--pp-primary); transform: translateY(-2px); }
  .pp-opt-btn.is-active {
    background: var(--pp-primary); border-color: var(--pp-primary); color: #FFFFFF; font-weight: 700;
    box-shadow: 0 6px 16px rgba(1, 63, 62, 0.22); transform: translateY(-2px);
  }

  /* Luxury Actions & Quantity Widget: Inter, 16px, Weight 700, Architectural 10px Radius */
  .pp-actions-container { width: 100% !important; margin-bottom: 28px !important; }
  .pp-actions-top-row { display: flex !important; gap: 14px !important; width: 100% !important; margin-bottom: 14px !important; }
  
  .pp-qty-widget {
    display: flex !important; align-items: center !important; justify-content: space-between !important;
    width: 130px !important; min-height: 56px !important; height: 56px !important;
    background: #FFFFFF !important; border: 1.5px solid #DED8CE !important; border-radius: 10px !important;
    flex-shrink: 0 !important; overflow: hidden !important; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02) !important;
  }
  .pp-qty-btn {
    width: 42px !important; height: 100% !important; background: none !important; border: none !important;
    font-size: 20px !important; font-weight: 600 !important; color: #013F3E !important; cursor: pointer !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    transition: background 0.2s ease !important; user-select: none !important; -webkit-user-select: none !important;
  }
  .pp-qty-btn:hover { background: #F5F3EF !important; }
  .pp-qty-input {
    width: 46px !important; height: 100% !important; border: none !important;
    border-left: 1px solid #E5E0D8 !important; border-right: 1px solid #E5E0D8 !important;
    text-align: center !important; font-family: var(--pp-font-sans) !important; font-size: 16px !important;
    font-weight: 600 !important; color: #111111 !important; background: none !important; pointer-events: none !important;
  }
  input[type="number"].pp-qty-input::-webkit-inner-spin-button,
  input[type="number"].pp-qty-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  input[type="number"].pp-qty-input { -moz-appearance: textfield; }

  .pp-btn-add {
    flex: 1 !important; width: 100% !important; background: #013F3E !important; color: #ffffff !important;
    border: none !important; border-radius: 10px !important; min-height: 56px !important; height: 56px !important;
    font-family: var(--pp-font-sans) !important; font-size: 16px !important; font-weight: 700 !important; line-height: 1 !important;
    letter-spacing: 0.06em !important; text-transform: uppercase !important; display: flex !important; align-items: center !important; justify-content: center !important;
    gap: 10px !important; cursor: pointer !important; transition: all 0.25s ease !important; box-shadow: 0 6px 20px rgba(1, 63, 62, 0.2) !important;
    padding: 0 20px !important;
  }
  .pp-btn-add:hover { background: #012B2A !important; transform: translateY(-2px) !important; box-shadow: 0 8px 26px rgba(1, 63, 62, 0.35) !important; }
  .pp-btn-buy {
    width: 100% !important; background: #C89234 !important; color: #ffffff !important;
    border: none !important; border-radius: 10px !important; min-height: 56px !important; height: 56px !important;
    font-family: var(--pp-font-sans) !important; font-size: 16px !important; font-weight: 700 !important; line-height: 1 !important;
    letter-spacing: 0.06em !important; text-transform: uppercase !important; display: flex !important; align-items: center !important; justify-content: space-between !important;
    cursor: pointer !important; transition: all 0.25s ease !important; box-shadow: 0 6px 20px rgba(200, 146, 52, 0.25) !important;
    padding: 0 24px !important;
  }
  .pp-btn-buy:hover { background: #B5822C !important; transform: translateY(-2px) !important; box-shadow: 0 8px 26px rgba(200, 146, 52, 0.38) !important; }
  .pp-btn-spacer { width: 20px; flex-shrink: 0; }
  .pp-btn-text { flex: 1; text-align: center; }
  .pp-btn-arrow { width: 20px; height: 20px; flex-shrink: 0; transition: transform 0.25s ease; }
  .pp-btn-buy:hover .pp-btn-arrow { transform: translateX(4px); }

  /* ==========================================================================
     5. BOTTOM SHOWCASE (Architectural Luxury Cards matching Mobile UI)
     ========================================================================== */
  .pp-bottom-showcase { max-width: 1000px; margin: 30px auto 50px auto; padding: 0 20px; font-family: var(--pp-font-sans); }
  .pp-bottom-showcase-grid { display: flex; flex-direction: column; gap: 20px; width: 100%; }
  .pp-bottom-card { background: var(--pp-bg-light); border: 1px solid var(--pp-border); border-radius: 20px; padding: 24px 32px; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.02); transition: all 0.3s ease; }
  
  /* 1. About Card Styling (Clean & Compact without icons or excessive spacing) */
  .pp-about-card {
    background: #FFFFFF !important;
    border: 1px solid #E8DEC9 !important;
