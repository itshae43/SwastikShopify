{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="premium-product" data-product-id="{{ product.id }}" data-url="{{ product.url }}">
  {% render 'breadcrumb', product: product, collection: collection %}

  <div class="pp-container">
    
    <!-- LEFT COLUMN -->
    <div class="pp-left">
      <!-- Gallery -->
      <div class="pp-gallery">
        <div class="pp-main-image-wrap">

          <button class="pp-nav-btn pp-nav-prev" aria-label="Previous">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          
          <div class="pp-main-img-container">
            {% if product.featured_image %}
              <img id="pp-main-image" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" height="1000">
            {% else %}
              <img id="pp-main-image" src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Luxury Diamond Jewelry" width="1000" height="1000">
            {% endif %}
          </div>
          
          <button class="pp-nav-btn pp-nav-next" aria-label="Next">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
          
          <button class="pp-fullscreen-btn" aria-label="Fullscreen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
        </div>
        
        <!-- Thumbnails Horizontal Carousel Below Main Image -->
        <div class="pp-thumbnails-section">
          <button class="pp-thumb-nav-btn pp-thumb-nav-prev" type="button" aria-label="Previous Thumbnails">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>

          {% if product.images.size > 1 %}
            <div class="pp-thumbnails-wrapper">
              <div class="pp-thumbnails">
                {% for image in product.images %}
                  <div class="pp-thumb-item {% if forloop.first %}is-active{% endif %}" data-image="{{ image | image_url: width: 1000 }}">
                    <div class="pp-thumb-img">
                      <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | escape }}" width="180" height="180">
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <div class="pp-thumbnails-wrapper">
              <div class="pp-thumbnails">
                {% if product.featured_image %}
                  <div class="pp-thumb-item is-active" data-image="{{ product.featured_image | image_url: width: 1000 }}">
                    <div class="pp-thumb-img">
                      <img src="{{ product.featured_image | image_url: width: 180 }}" alt="{{ product.title | escape }}" width="180" height="180">
                    </div>
                  </div>
                {% endif %}
                {% assign luxury_fallbacks = "best_seller_pendant.png,best_seller_earrings.png,best_seller_ring.png,best_seller_bracelet.png" | split: "," %}
                {% for img_name in luxury_fallbacks %}
                  {% unless product.featured_image and forloop.first %}
                    <div class="pp-thumb-item {% if product.featured_image == blank and forloop.first %}is-active{% endif %}" data-image="{{ img_name | asset_url }}">
                      <div class="pp-thumb-img">
                        <img src="{{ img_name | asset_url }}" alt="Luxury Jewelry Thumbnail" width="180" height="180">
                      </div>
                    </div>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <button class="pp-thumb-nav-btn pp-thumb-nav-next" type="button" aria-label="Next Thumbnails">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>


    </div>

    <!-- RIGHT COLUMN -->
    <div class="pp-right">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="pp-header-block">
              <h1 class="pp-title">{{ product.title }}</h1>
              

              
              <div class="pp-meta-row">
                <div class="pp-reviews">
                  <div class="pp-stars">
                    {% for i in (1..5) %}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="#F5C518"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    {% endfor %}
                  </div>
                  <span class="pp-review-text">4.8 (128 Reviews)</span>
                </div>
                <div class="pp-sku-wrap">
                  <span class="pp-sku-label">SKU:</span>
                  <span class="pp-sku-val" id="pp-sku">{{ current_variant.sku | default: 'SWRK-NC-1024' }}</span>
                </div>
              </div>
            </div>

          {%- when 'price' -%}
            <div class="pp-price-box">
              <div class="pp-price-box-top">
                <span class="pp-price-current" id="pp-price">{{ current_variant.price | money }}</span>
                <span class="pp-price-tax-label">(Incl. of all taxes)</span>
              </div>
              <div class="pp-price-box-bottom">
                {% assign compare_price = current_variant.compare_at_price %}
                <span class="pp-price-compare" id="pp-compare-price" {% unless compare_price > current_variant.price %}style="display:none;"{% endunless %}>MRP {{ compare_price | money }}</span>
              </div>
            </div>

          {%- when 'variant_picker' -%}
            {% form 'product', product, id: 'pp-product-form' %}
              <input type="hidden" name="id" id="pp-variant-id" value="{{ current_variant.id }}">
              <input type="hidden" name="quantity" class="pp-qty-val" value="1">
              
              {%- unless product.has_only_default_variant -%}
                <div class="pp-variants">
                  {%- for option in product.options_with_values -%}
                    {%- assign name_dc = option.name | downcase -%}
                    <div class="pp-option-group" data-option-index="{{ forloop.index0 }}">
                      <label class="pp-option-label">{{ option.name }}</label>
                      {%- assign opt_vals = option.values -%}
                      {%- if name_dc contains 'color' or name_dc contains 'colour' or name_dc contains 'metal' -%}
                        {%- assign color_order = "rose,yellow,white" | split: "," -%}
                        {%- assign ordered_vals = "" -%}
                        {%- for color_key in color_order -%}
                          {%- for value in option.values -%}
                            {%- assign val_dc = value | downcase -%}
                            {%- if val_dc contains color_key -%}
                              {%- assign ordered_vals = ordered_vals | append: value | append: "|||" -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endfor -%}
                        {%- for value in option.values -%}
                          {%- assign val_dc = value | downcase -%}
                          {%- unless val_dc contains 'rose' or val_dc contains 'yellow' or val_dc contains 'white' -%}
                            {%- assign ordered_vals = ordered_vals | append: value | append: "|||" -%}
                          {%- endunless -%}
                        {%- endfor -%}
                        {%- assign opt_vals = ordered_vals | split: "|||" -%}
                        
                        <!-- Metal Color Swatches -->
                        <div class="pp-option-values pp-swatches">
                          {%- for value in opt_vals -%}
                            {%- if value == blank %}{% continue %}{% endif -%}
                            {%- assign val_dc = value | downcase -%}
                            {%- assign bg_color = '#D4AF37' -%}
                            {%- if val_dc contains 'rose' or val_dc contains 'pink' -%}
                              {%- assign bg_color = '#E6C2B8' -%}
                            {%- elsif val_dc contains 'white' or val_dc contains 'silver' or val_dc contains 'platinum' -%}
                              {%- assign bg_color = '#E5E5E5' -%}
                            {%- endif -%}
                            <button type="button" class="pp-opt-btn pp-swatch-btn {% if option.selected_value == value %}is-active{% endif %}" data-value="{{ value | escape }}" title="{{ value | escape }}" style="--swatch-color: {{ bg_color }};">
                              <span class="pp-swatch-circle"></span>
                            </button>
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        {%- if name_dc contains 'purity' or name_dc contains 'gold' or name_dc contains 'carat' or name_dc contains 'karat' -%}
                          {%- assign purity_order = "9,10,14,18,22,24" | split: "," -%}
                          {%- assign ordered_vals = "" -%}
                          {%- for p_key in purity_order -%}
                            {%- for value in option.values -%}
                              {%- if value contains p_key -%}
                                {%- assign ordered_vals = ordered_vals | append: value | append: "|||" -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endfor -%}
                          {%- for value in option.values -%}
                            {%- assign has_match = false -%}
                            {%- for p_key in purity_order -%}
                              {%- if value contains p_key -%}
                                {%- assign has_match = true -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- unless has_match -%}
                              {%- assign ordered_vals = ordered_vals | append: value | append: "|||" -%}
                            {%- endunless -%}
                          {%- endfor -%}
                          {%- assign opt_vals = ordered_vals | split: "|||" -%}
                        {%- endif -%}

                        <!-- Gold Purity, Diamond Quality, or other Options (Rounded Pill Container) -->
                        <div class="pp-option-values pp-pill-container">
                          {%- for value in opt_vals -%}
                            {%- if value == blank %}{% continue %}{% endif -%}
                            <button type="button" class="pp-opt-btn {% if option.selected_value == value %}is-active{% endif %}" data-value="{{ value | escape }}">
                              {%- assign name_dc = option.name | downcase -%}
                              {%- if name_dc contains 'diamond quality' or name_dc contains 'quality' -%}
                                {%- assign split_val = value | split: " " -%}
                                {%- if split_val.size > 1 -%}
                                  <span style="display:block; line-height:1.2;">{{ split_val[0] }}</span>
                                  <span style="display:block; line-height:0.8; font-weight:300; opacity:0.5; margin: 2px 0;">&mdash;</span>
                                  <span style="display:block; line-height:1.2;">{{ split_val[1] }}</span>
                                {%- else -%}
                                  {{ value }}
                                {%- endif -%}
                              {%- else -%}
                                {{ value }}
                              {%- endif -%}
                            </button>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <!-- Fallback to display luxury options matching screenshot when product options are not set in local dev -->
                <div class="pp-variants">
                  <div class="pp-option-group">
                    <label class="pp-option-label">Metal Color</label>
                    <div class="pp-option-values pp-swatches">
                      <button type="button" class="pp-opt-btn pp-swatch-btn" data-value="Rose Gold" title="Rose Gold" style="--swatch-color: #E6C2B8;"><span class="pp-swatch-circle"></span></button>
                      <button type="button" class="pp-opt-btn pp-swatch-btn is-active" data-value="Yellow Gold" title="Yellow Gold" style="--swatch-color: #D4AF37;"><span class="pp-swatch-circle"></span></button>
                      <button type="button" class="pp-opt-btn pp-swatch-btn" data-value="White Gold" title="White Gold" style="--swatch-color: #E5E5E5;"><span class="pp-swatch-circle"></span></button>
                    </div>
                  </div>
                  <div class="pp-option-group">
                    <label class="pp-option-label">Gold Purity</label>
                    <div class="pp-option-values pp-pill-container">
                      <button type="button" class="pp-opt-btn" data-value="9K">9K</button>
                      <button type="button" class="pp-opt-btn" data-value="14K">14K</button>
                      <button type="button" class="pp-opt-btn is-active" data-value="18K">18K</button>
                    </div>
                  </div>
                  <div class="pp-option-group">
                    <label class="pp-option-label">Diamond Quality</label>
                    <div class="pp-option-values pp-pill-container">
                      <button type="button" class="pp-opt-btn is-active" data-value="G-VS">G-VS</button>
                      <button type="button" class="pp-opt-btn" data-value="F-VVS">F-VVS</button>
                      <button type="button" class="pp-opt-btn" data-value="E-VVS">E-VVS</button>
                    </div>
                  </div>
                </div>
              {%- endunless -%}
            {% endform %}

          {%- when 'buy_buttons' -%}
            <div class="pp-actions-container">
              <!-- ROW 1: QUANTITY + ADD TO CART -->
              <div class="pp-actions-top-row">
                <div class="pp-qty-widget">
                  <button type="button" class="pp-qty-btn pp-qty-minus" aria-label="Decrease quantity">−</button>
                  <input type="number" name="quantity" value="1" min="1" class="pp-qty-input" form="pp-product-form" readonly>
                  <button type="button" class="pp-qty-btn pp-qty-plus" aria-label="Increase quantity">+</button>
                </div>
                <button type="submit" form="pp-product-form" class="pp-btn-add">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  <span>ADD TO CART</span>
                </button>
              </div>

              <!-- ROW 2: BUY NOW WITH ARROW -->
              <button type="button" class="pp-btn-buy" id="pp-buy-now">
                <span class="pp-btn-spacer"></span>
                <span class="pp-btn-text">BUY NOW</span>
                <svg class="pp-btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>


        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="pp-bottom-showcase" id="details">
    <div class="pp-bottom-showcase-grid">
      
      <!-- 1. ABOUT THIS JEWELLERY (Editorial Text Section - No Card Box/Border) -->
      <div class="pp-about-text-section">
        <div class="pp-about-header">
          <h3 class="pp-about-title">About This Jewellery</h3>
        </div>
        <div class="pp-about-content">
          <div class="pp-about-desc">
            {%- if product.description != blank -%}
              <div class="pp-about-short">{{ product.description }}</div>
            {%- else -%}
              <p class="pp-about-short">An elegant teardrop pendant perfect for any occasion. Handcrafted in 18K yellow gold and adorned with naturally brilliant diamonds, every detail is designed to celebrate love and beauty.</p>
            {%- endif -%}
            <p class="pp-about-more" style="display: none;">Each masterpiece is individually inspected by master gemologists to ensure exceptional brilliance, fire, and structural durability. Designed to sit comfortably for everyday wear while making an extraordinary statement of luxury that lasts a lifetime.</p>
          </div>
          <div class="pp-about-link-wrap">
            <button type="button" class="pp-read-more-link" id="pp-read-more-toggle">
              <span class="pp-rm-text">Read more +</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 2. SEGMENTED CONTROL & INFORMATION CARD (Figma Spec 1:1) -->
      <div class="pp-tabs-card pp-segmented-section">
        <!-- Top Segmented Control (Height 60px, Inset 4px, Radius 18px) -->
        <div class="pp-segmented-control">
          <button type="button" class="pp-tab-btn pp-segment-btn is-active" data-target="tab-details">
            <svg class="pp-tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9l4-6z"/><path d="M11 3l4 6-4 12"/><path d="M13 3l-4 6 4 12"/><path d="M2 9h20"/></svg>
            <span class="pp-segment-text">Product Details</span>
          </button>
          <button type="button" class="pp-tab-btn pp-segment-btn" data-target="tab-price">
            <svg class="pp-tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span class="pp-segment-text">Price Breakdown</span>
          </button>
        </div>

        <!-- Card Below: Tab 1 (Product Details) -->
        <div class="pp-info-card pp-tab-body is-active" id="tab-details">
          <div class="pp-table-row">
            <span class="pp-row-label">Metal</span>
            <span class="pp-row-value" id="ui-detail-metal">18K Yellow Gold</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <span class="pp-row-label">Gross Weight</span>
            <span class="pp-row-value" id="ui-detail-gross">{{ product.metafields.custom.gross_weight | default: '16.350 gms' }}</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <span class="pp-row-label">Net Weight</span>
            {%- comment -%} The store definition is the misspelled net_wight; net_weight is the newer key. {%- endcomment -%}
            {%- assign net_wt = product.metafields.custom.net_weight | default: product.metafields.custom.net_wight -%}
            <span class="pp-row-value" id="ui-detail-net">{{ net_wt | default: '14.250 gms' }}</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <span class="pp-row-label">Diamond Weight</span>
            <span class="pp-row-value" id="ui-detail-diamond">{{ product.metafields.custom.diamond_weight | default: '1.75 cts' }}</span>
          </div>
          {%- assign stone_wt = product.metafields.custom.stone_weight | default: '0' -%}
          {%- unless stone_wt == '0' or stone_wt == '' or stone_wt == blank -%}
          <div class="pp-row-divider"></div>

          <div class="pp-table-row" id="ui-stone-row">
            <span class="pp-row-label">Stone Weight</span>
            <span class="pp-row-value" id="ui-detail-stone">{{ stone_wt }}</span>
          </div>
          {%- endunless -%}

          <div class="pp-table-row">
            <span class="pp-row-label">Diamond Quality</span>
            <span class="pp-row-value" id="ui-detail-quality">G–VS</span>
          </div>

        </div>

        <!-- Card Below: Tab 2 (Price Breakdown) -->
        <div class="pp-info-card pp-tab-body" id="tab-price" style="display: none;">
          <div class="pp-table-row">
            <span class="pp-row-label" id="ui-label-gold">Gold Value</span>
            <span class="pp-row-value" id="ui-price-gold">₹{{ current_variant.metafields.custom.gold_value | default: '0' }}</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <span class="pp-row-label" id="ui-label-dia-val">Diamond Value</span>
            <span class="pp-row-value" id="ui-price-diamond">₹{{ current_variant.metafields.custom.diamond_value | default: '0' }}</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <span class="pp-row-label">Making Charges</span>
            <span class="pp-row-value" id="ui-price-making">₹{{ current_variant.metafields.custom.making_charges | default: '13500' }}</span>
          </div>
          <div class="pp-row-divider"></div>

          <div class="pp-table-row">
            <span class="pp-row-label">GST (3%)</span>
            <span class="pp-row-value" id="ui-price-gst">₹{{ current_variant.metafields.custom.gst_amount | default: '0' }}</span>
          </div>
          <div class="pp-table-row pp-total-row">
            <span class="pp-row-label">TOTAL PRICE</span>
            <span class="pp-row-value" id="ui-price-total">{{ current_variant.price | money }}</span>
          </div>
        </div>
      </div>

      <!-- 3. COLLAPSIBLE ACCORDION ITEMS (Dynamic via Metafields) -->
      <div class="pp-accordions-group">
        
        <!-- 2. Key Features -->
        {%- assign acc_features = product.metafields.custom.key_features -%}
        <div class="pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <span class="pp-acc-title">KEY FEATURES</span>
            </span>
            <svg class="pp-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0E4A43" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            {%- if acc_features != blank -%}
              {{ acc_features | metafield_tag }}
            {%- else -%}
              <p>No specific features listed for this product.</p>
            {%- endif -%}
          </div>
        </div>

        <!-- 3. Styling Tip -->
        {%- assign acc_styling = product.metafields.custom.styling_tip -%}
        <div class="pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/><path d="M9 12l2 2 4-4"/></svg>
              <span class="pp-acc-title">STYLING TIP</span>
            </span>
            <svg class="pp-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0E4A43" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            {%- if acc_styling != blank -%}
              {{ acc_styling | metafield_tag }}
            {%- else -%}
              <p>Pair this elegant piece with your favorite evening or ethnic wear.</p>
            {%- endif -%}
          </div>
        </div>

        <!-- 4. Care Instructions -->
        {%- assign acc_care = product.metafields.custom.care_instructions -%}
        <div class="pp-acc-item">
          <button class="pp-acc-header" type="button" aria-expanded="false">
            <span class="pp-acc-header-left">
              <svg class="pp-acc-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B3C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <span class="pp-acc-title">CARE INSTRUCTIONS</span>
            </span>
            <svg class="pp-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0E4A43" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pp-acc-content">
            {%- if acc_care != blank -%}
              {{ acc_care | metafield_tag }}
            {%- else -%}
              <p>Store in a dry place. Clean gently with a soft cloth.</p>
            {%- endif -%}
          </div>
        </div>

      </div>
      
    </div>
  </div>

  <!-- You May Also Like Product Recommendations (Shopify Native AI & Luxury Fallback without Bounding Box) -->
  <product-recommendations class="pp-recommendations-section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
    <div class="pp-section-header-wrap">
      <h2 class="pp-section-title">People Also Bought</h2>
    </div>

    <div class="pp-related-carousel-container">
      <button type="button" class="pp-rel-arrow pp-rel-prev" aria-label="Previous Products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="pp-related-grid" id="pp-related-grid">
        {% assign rel_count = 0 %}
        {% if recommendations.performed and recommendations.products_count > 0 %}
          {% for rel_product in recommendations.products %}
            {% if rel_count < 4 %}
              {% assign rel_count = rel_count | plus: 1 %}
                <a href="{{ rel_product.url }}" class="pp-related-item-card" style="text-decoration: none;">
                  <div class="pp-related-img-wrap">
                  {% if rel_product.featured_image %}
                    <img src="{{ rel_product.featured_image | image_url: width: 400 }}" alt="{{ rel_product.title | escape }}" width="400" height="400" loading="lazy">
                  {% else %}
                    <img src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Jewelry" width="400" height="400" loading="lazy">
                  {% endif %}
                </div>
                <div class="pp-related-info">
                  <h3 class="pp-related-item-title">{{ rel_product.title }}</h3>
                  <div class="pp-related-pills">
                    <span class="pp-rel-pill">22K Gold</span>
                    <span class="pp-rel-pill">BIS 916</span>
                    <span class="pp-rel-pill">Certified</span>
                    <span class="pp-rel-pill">In Stock</span>
                  </div>
                  {% assign rev_count = rel_product.id | modulo: 80 | plus: 48 %}
                  <div class="pp-related-reviews">
                    <span class="pp-rel-stars">★★★★★</span>
                    <span class="pp-rel-rev-count">({{ rev_count }})</span>
                  </div>
                  <div class="pp-related-price-row">
                    <span class="pp-rel-current">{{ rel_product.price | money | replace: '$', '₹' | replace: 'USD', '₹' }}</span>
                    {% if rel_product.compare_at_price > rel_product.price %}
                      <s class="pp-rel-compare">{{ rel_product.compare_at_price | money | replace: '$', '₹' | replace: 'USD', '₹' }}</s>
                    {% else %}
                        {% assign approx_comp = rel_product.price | times: 1.6 | divided_by: 100 | round | times: 100 %}
                      <s class="pp-rel-compare">{{ approx_comp | money | replace: '$', '₹' | replace: 'USD', '₹' }}</s>
                    {% endif %}
                  </div>
                  <div class="pp-rel-view-btn">
                    <span>View Details</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pp-rel-bag-icon"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  </div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        {% else %}
          {% assign related_collection = collections['frontpage'] | default: collections.all %}
          {% for rel_product in related_collection.products %}
            {% unless rel_product.id == product.id %}
              {% if rel_count < 4 %}
                {% assign rel_count = rel_count | plus: 1 %}
                {% assign badge_disc = 25 %}
                {% if rel_product.compare_at_price > rel_product.price %}
                  {% assign badge_disc = rel_product.compare_at_price | minus: rel_product.price | times: 100 | divided_by: rel_product.compare_at_price %}
                {% elsif rel_count == 1 %}
                  {% assign badge_disc = 60 %}
                {% elsif rel_count == 2 %}
                  {% assign badge_disc = 61 %}
                {% elsif rel_count == 3 %}
                  {% assign badge_disc = 55 %}
                {% else %}
                  {% assign badge_disc = 50 %}
                {% endif %}
                <a href="{{ rel_product.url }}" class="pp-related-item-card" style="text-decoration: none;">
                  <div class="pp-related-img-wrap">
                    <span class="pp-rel-badge">-{{ badge_disc }}%</span>
                    {% if rel_product.featured_image %}
                      <img src="{{ rel_product.featured_image | image_url: width: 400 }}" alt="{{ rel_product.title | escape }}" width="400" height="400" loading="lazy">
                    {% else %}
                      <img src="{{ 'best_seller_pendant.png' | asset_url }}" alt="Jewelry" width="400" height="400" loading="lazy">
                    {% endif %}
                  </div>
                  <div class="pp-related-info">
                    <h3 class="pp-related-item-title">{{ rel_product.title }}</h3>
                    <div class="pp-related-pills">
                      <span class="pp-rel-pill">22K Gold</span>
                      <span class="pp-rel-pill">BIS 916</span>
                      <span class="pp-rel-pill">Certified</span>
                      <span class="pp-rel-pill">In Stock</span>
                    </div>
                    {% assign rev_count = rel_product.id | modulo: 80 | plus: 48 %}
                    <div class="pp-related-reviews">
                      <span class="pp-rel-stars">★★★★★</span>
                      <span class="pp-rel-rev-count">({{ rev_count }})</span>
                    </div>
                    <div class="pp-related-price-row">
                      <span class="pp-rel-current">{{ rel_product.price | money | replace: '$', '₹' | replace: 'USD', '₹' }}</span>
                      {% if rel_product.compare_at_price > rel_product.price %}
                        <s class="pp-rel-compare">{{ rel_product.compare_at_price | money | replace: '$', '₹' | replace: 'USD', '₹' }}</s>
                      {% else %}
                          {% assign approx_comp = rel_product.price | times: 1.6 | divided_by: 100 | round | times: 100 %}
                        <s class="pp-rel-compare">{{ approx_comp | money | replace: '$', '₹' | replace: 'USD', '₹' }}</s>
                      {% endif %}
                    </div>
                    <div class="pp-rel-view-btn">
                      <span>View Details</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pp-rel-bag-icon"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </div>
                  </div>
                </a>
              {% endif %}
            {% endunless %}
          {% endfor %}
        {% endif %}

        {% if rel_count < 4 %}
          {% assign missing_count = 4 | minus: rel_count %}
          {% for i in (1..missing_count) %}
            {% assign demo_index = i | plus: rel_count %}
            {% if demo_index == 1 %}
              {% assign fallback_title = "Swastik Diamond Stud Earrings" %}
              {% assign fallback_price = "₹2,499.00" %}
              {% assign fallback_comp = "₹3,998.00" %}
              {% assign fallback_disc = "60" %}
              {% assign fallback_img = "best_seller_earrings.png" %}
            {% elsif demo_index == 2 %}
              {% assign fallback_title = "Gold & Diamond Earrings" %}
              {% assign fallback_price = "₹89,900.00" %}
              {% assign fallback_comp = "₹2,30,500.00" %}
              {% assign fallback_disc = "61" %}
              {% assign fallback_img = "best_seller_earrings.png" %}
            {% elsif demo_index == 3 %}
              {% assign fallback_title = "Classic Gold Ring" %}
              {% assign fallback_price = "₹59,900.00" %}
              {% assign fallback_comp = "₹1,33,000.00" %}
              {% assign fallback_disc = "55" %}
              {% assign fallback_img = "best_seller_ring.png" %}
            {% else %}
              {% assign fallback_title = "Diamond Bracelet" %}
              {% assign fallback_price = "₹1,25,900.00" %}
              {% assign fallback_comp = "₹2,51,800.00" %}
              {% assign fallback_disc = "50" %}
              {% assign fallback_img = "best_seller_bracelet.png" %}
            {% endif %}
            <div class="pp-related-item-card">
              <div class="pp-related-img-wrap">
                <span class="pp-rel-badge">-{{ fallback_disc }}%</span>
                <img src="{{ fallback_img | asset_url }}" alt="{{ fallback_title }}" width="400" height="400" loading="lazy">
              </div>
              <div class="pp-related-info">
                <h3 class="pp-related-item-title">{{ fallback_title }}</h3>
                <div class="pp-related-pills">
                  <span class="pp-rel-pill">22K Gold</span>
                  <span class="pp-rel-pill">BIS 916</span>
                  <span class="pp-rel-pill">Certified</span>
                  <span class="pp-rel-pill">In Stock</span>
                </div>
                {% assign demo_rev = demo_index | times: 32 | plus: 64 %}
                <div class="pp-related-reviews">
                  <span class="pp-rel-stars">★★★★★</span>
                  <span class="pp-rel-rev-count">({{ demo_rev }})</span>
                </div>
                <div class="pp-related-price-row">
                  <span class="pp-rel-current">{{ fallback_price }}</span>
                  <s class="pp-rel-compare">{{ fallback_comp }}</s>
                </div>
                <div class="pp-rel-view-btn">
                  <span>View Details</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pp-rel-bag-icon"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <button type="button" class="pp-rel-arrow pp-rel-next" aria-label="Next Products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <div class="pp-rel-dots" id="pp-rel-dots">
      <span class="pp-rel-dot is-active" data-index="0"></span>
      <span class="pp-rel-dot" data-index="1"></span>
      <span class="pp-rel-dot" data-index="2"></span>
      <span class="pp-rel-dot" data-index="3"></span>
      <span class="pp-rel-dot" data-index="4"></span>
    </div>
  </product-recommendations>
</div>

<script id="pp-metafields-json" type="application/json">
  {
    "gross_weight": {{ product.metafields.custom.gross_weight | json }},
    "net_weight": {{ product.metafields.custom.net_weight | json }},
    "diamond_weight": {{ product.metafields.custom.diamond_weight | json }},
    "stone_weight": {{ product.metafields.custom.stone_weight | json }},
    "making_charges": {{ product.metafields.custom.making_charges | json }}
  }
</script>

<script id="pp-variants-json" type="application/json">
  {{ product.variants | json }}
</script>

<script id="pp-variant-metafields-json" type="application/json">
  {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "gold_value": {{ variant.metafields.custom.gold_value | json }},
        "diamond_value": {{ variant.metafields.custom.diamond_value | json }},
        "making_charges": {{ variant.metafields.custom.making_charges | json }},
        "gst_amount": {{ variant.metafields.custom.gst_amount | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --pp-primary: #013F3E;
    --pp-primary-hover: #012B2A;
    --pp-accent: #D4AF37;
    --pp-accent-hover: #C29D2C;
    --pp-bg-light: #FAF7F0;
    --pp-border: #EAE0D5;
    --pp-text: #222222;
    --pp-text-muted: #666666;
    --pp-font-serif: 'Cormorant Garamond', Georgia, serif;
    --pp-font-sans: 'Inter', -apple-system, sans-serif;
  }

  /* ==========================================================================
     1. BREADCRUMBS NAVIGATION
     ========================================================================== */
  .pp-breadcrumb-nav {
    width: 100%;
    margin-top: 16px;
    margin-bottom: 24px;
    font-family: var(--pp-font-sans);
  }
  .pp-breadcrumb-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .pp-breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap !important;
    white-space: normal !important;
    overflow-x: visible !important;
    gap: 6px 10px !important;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--pp-text-muted);
  }
  .pp-breadcrumb-item {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap !important;
  }
  .pp-breadcrumb-link {
    color: var(--pp-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }
  .pp-breadcrumb-link:hover {
    color: var(--pp-primary);
    text-decoration: underline;
  }
  .pp-home-icon { color: var(--pp-accent); display: flex; align-items: center; }
  .pp-breadcrumb-separator { display: inline-flex; align-items: center; color: #CCCCCC; margin-right: 10px; flex-shrink: 0; }
  .pp-breadcrumb-current { color: var(--pp-primary); font-weight: 600; word-break: break-word; }

  /* ==========================================================================
     2. MAIN PRODUCT CONTAINER & GRID
     ========================================================================== */
  .pp-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1240px;
    margin: 0 auto 50px auto;
    padding: 0 20px;
    font-family: var(--pp-font-sans);
    color: var(--pp-text);
  }
  @media screen and (min-width: 992px) {
    .pp-container {
      grid-template-columns: 540px 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* ==========================================================================
     3. LEFT COLUMN: LUXURY GALLERY (Constrained 540px Square)
     ========================================================================== */
  .pp-left {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
  }
  @media screen and (min-width: 992px) {
    .pp-left {
      position: sticky;
      top: 40px;
    }
  }

  .pp-gallery { width: 100%; display: flex; flex-direction: column; }

  .pp-main-image-wrap {
    position: relative;
    width: 100%;
    max-width: 540px;
    max-height: 540px;
    aspect-ratio: 1 / 1;
    background: #FAF7F0;
    border: 1px solid var(--pp-border);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 35px rgba(1, 63, 62, 0.04);
    margin: 0 auto;
  }
  .pp-main-img-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 0; }
  /* #pp-main-image styled below in zoom overlay section */


  .pp-nav-btn {
    position: absolute; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; border-radius: 50%;
    background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.06); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; color: #222222; transition: all 0.25s ease;
  }
  .pp-nav-btn:hover { background: var(--pp-primary); color: #ffffff; border-color: var(--pp-primary); transform: translateY(-50%) scale(1.05); }
  .pp-nav-prev { left: 16px; }
  .pp-nav-next { right: 16px; }

  .pp-fullscreen-btn {
    position: absolute; bottom: 16px; right: 16px; width: 40px; height: 40px; border-radius: 50%;
    background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.06); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; color: #222222; transition: all 0.25s ease;
  }
  .pp-fullscreen-btn:hover { transform: scale(1.08); color: var(--pp-primary); }

  /* Thumbnails Carousel */
  .pp-thumbnails-section { display: flex; align-items: center; gap: 12px; margin-top: 16px; width: 100%; max-width: 540px; position: relative; }
  .pp-thumb-nav-btn {
    width: 36px; height: 36px; border-radius: 50%; background: #ffffff; border: 1px solid var(--pp-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; color: #222222; transition: all 0.2s ease;
  }
  .pp-thumb-nav-btn:hover { background: var(--pp-primary); color: #ffffff; border-color: var(--pp-primary); }
  .pp-thumbnails-wrapper { flex: 1; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; -ms-overflow-style: none; padding: 4px 2px; }
  .pp-thumbnails-wrapper::-webkit-scrollbar { display: none; }
  .pp-thumbnails { display: flex; gap: 12px; width: max-content; }
  .pp-thumb-item { flex: 0 0 76px; width: 76px; height: 76px; border-radius: 12px; cursor: pointer; transition: transform 0.2s ease; }
  .pp-thumb-item:hover { transform: translateY(-2px); }
  .pp-thumb-img {
    width: 100%; height: 100%; border-radius: 12px; background: #FAF7F0; border: 2px solid #EAE0D5;
    overflow: hidden; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; padding: 0;
  }
  .pp-thumb-img img, .pp-thumb-img svg { width: 100%; height: 100%; object-fit: cover; }
  .pp-thumb-item.is-active .pp-thumb-img { border-color: #C89234 !important; box-shadow: 0 6px 16px rgba(200, 146, 52, 0.28) !important; transform: scale(1.02); }

  /* ==========================================================================
     4. RIGHT COLUMN: EXACT LUXURY TYPOGRAPHY & SPACING SCALE
     ========================================================================== */
  .pp-right {
    display: flex;
    flex-direction: column;
    gap: 0; /* Controlled precisely by luxury margins below */
    font-family: var(--pp-font-sans);
  }

  .pp-bestseller-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #C89234;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .pp-header-block {
    display: flex;
    flex-direction: column;
  }

  /* Product Title: Clean, premium Inter sans-serif, bold weight, readable & professional */
  .pp-title {
    font-family: var(--pp-font-sans);
    font-size: 38px;
    font-weight: 700;
    color: var(--pp-primary);
    line-height: 1.25;
    margin: 0 0 12px 0; /* Title -> Rating: 12px */
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Rating & Meta Row: Inter, 14px, Weight 500, Line Height 1.5 */
  .pp-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--pp-text-muted);
    margin-bottom: 20px; /* Rating -> Price: 20px */
    padding-bottom: 20px;
    border-bottom: 1px solid var(--pp-border);
  }
  .pp-reviews { display: flex; align-items: center; gap: 8px; }
  .pp-stars { display: flex; gap: 3px; color: #F59E0B; }
  .pp-review-text { font-weight: 600; color: #222222; }
  .pp-sku-wrap { color: var(--pp-text-muted); }
  .pp-sku-label { font-weight: 600; color: #444444; }

  /* Price: Inter, 40px, Weight 700, Line Height 1.1 */
  .pp-price-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px; /* Price -> Description: 24px */
    padding-bottom: 24px;
    border-bottom: 1px solid var(--pp-border);
  }
  .pp-price-box-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pp-price-current {
    font-family: var(--pp-font-sans);
    font-size: 40px;
    font-weight: 700;
    color: var(--pp-primary);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .pp-price-tax-label { font-size: 14px; font-weight: 500; color: var(--pp-text-muted); }
  .pp-price-box-bottom { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; font-size: 14px; }
  .pp-price-compare { color: #888888; text-decoration: line-through; font-weight: 500; }
  .pp-price-save-text { color: #C87A1E; font-weight: 700; background: #FFF4E6; padding: 4px 10px; border-radius: 6px; font-size: 13px; }

  /* Variants Block */
  .pp-variants {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 32px; /* Variants -> CTA: 32px */
    padding-bottom: 32px;
    border-bottom: 1px solid var(--pp-border);
  }
  .pp-option-group { display: flex; flex-direction: column; gap: 10px; margin-bottom: 6px; }
  .pp-option-label {
    font-family: var(--pp-font-sans);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
    color: #111111;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pp-option-values { display: flex; flex-wrap: wrap; gap: 12px; }
  
  /* Color Swatches (Round circles with double border ring when active) */
  .pp-swatches { display: flex !important; align-items: center !important; gap: 14px !important; }
  button.pp-opt-btn.pp-swatch-btn {
    width: 32px !important; height: 32px !important; min-width: 32px !important; min-height: 32px !important;
    border-radius: 50% !important; padding: 3px !important; margin: 0 !important;
    background: transparent !important; border: 2px solid transparent !important; cursor: pointer !important;
    display: inline-flex !important; align-items: center !important; justify-content: center !important;
