    .pp-breadcrumb-separator { margin-right: 6px !important; margin-left: 2px !important; display: inline-flex !important; align-items: center !important; flex-shrink: 0 !important; }
    .pp-actions-top-row { display: flex !important; flex-direction: row !important; gap: 10px !important; }
    .pp-qty-widget { width: 120px !important; min-height: 52px !important; height: 52px !important; }
