  .pp-zoom-close:hover { background: #E53E3E; color: #FFFFFF; border-color: #E53E3E; transform: scale(1.1) rotate(90deg); }
  
  /* Four Rounded Corner Way in Full Screen Mode without empty box padding */
  #pp-zoom-img {
    width: auto !important;
    height: auto !important;
    max-width: 90vw !important;
    max-height: 86vh !important;
