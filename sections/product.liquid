<script>
document.addEventListener('DOMContentLoaded', () => {
  // Gallery
  const thumbs = document.querySelectorAll('.pp-thumb-item');
  const mainImg = document.getElementById('pp-main-image');
  const prevBtn = document.querySelector('.pp-nav-prev');
  const nextBtn = document.querySelector('.pp-nav-next');
  let activeIndex = 0;

  function setMainImage(index) {
    if(!thumbs.length) return;
    activeIndex = (index + thumbs.length) % thumbs.length;
    thumbs.forEach(t => t.classList.remove('is-active'));
    thumbs[activeIndex].classList.add('is-active');
    
    if(mainImg) {
      mainImg.style.opacity = 0;
      setTimeout(() => {
        mainImg.src = thumbs[activeIndex].getAttribute('data-image');
        mainImg.style.opacity = 1;
      }, 150);
    }
  }

  thumbs.forEach((t, i) => {
    t.addEventListener('click', () => setMainImage(i));
  });

  if(prevBtn) prevBtn.addEventListener('click', () => setMainImage(activeIndex - 1));
  if(nextBtn) nextBtn.addEventListener('click', () => setMainImage(activeIndex + 1));
  if(mainImg) mainImg.style.transition = 'opacity 0.2s ease-in-out';

  // Thumbnail Carousel Arrows
  const thumbPrev = document.querySelector('.pp-thumb-nav-prev');
  const thumbNext = document.querySelector('.pp-thumb-nav-next');
  const thumbWrapper = document.querySelector('.pp-thumbnails-wrapper');
  if(thumbPrev && thumbWrapper) {
    thumbPrev.addEventListener('click', () => {
      thumbWrapper.scrollBy({ left: -200, behavior: 'smooth' });
    });
  }
  if(thumbNext && thumbWrapper) {
    thumbNext.addEventListener('click', () => {
      thumbWrapper.scrollBy({ left: 200, behavior: 'smooth' });
    });
  }

  // Read More Toggle
  const readMoreBtn = document.getElementById('pp-read-more-btn');
  const descShort = document.querySelector('.pp-desc-short');
  const descFull = document.querySelector('.pp-desc-full');
  const readMoreText = document.querySelector('.pp-read-more-text');
  const readMoreIcon = document.querySelector('.pp-read-more-icon');
  if(readMoreBtn && descShort && descFull) {
    readMoreBtn.addEventListener('click', () => {
      const isExpanded = readMoreBtn.getAttribute('aria-expanded') === 'true';
      if(isExpanded) {
        descShort.style.display = 'inline';
        descFull.style.display = 'none';
        if(readMoreText) readMoreText.textContent = 'Read More';
        if(readMoreIcon) readMoreIcon.style.transform = 'rotate(0deg)';
        readMoreBtn.setAttribute('aria-expanded', 'false');
      } else {
        descShort.style.display = 'none';
        descFull.style.display = 'inline';
        if(readMoreText) readMoreText.textContent = 'Read Less';
        if(readMoreIcon) readMoreIcon.style.transform = 'rotate(180deg)';
        readMoreBtn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  // Accordions
  const accHeaders = document.querySelectorAll('.pp-acc-header, .pp-full-accordion-header');
  accHeaders.forEach(h => {
    h.addEventListener('click', () => {
      const item = h.parentElement;
      const isOpen = item.classList.contains('is-open');
      const content = item.querySelector('.pp-acc-content, .pp-full-accordion-content');
      const chevron = item.querySelector('.pp-acc-chevron');
      
      document.querySelectorAll('.pp-acc-item, .pp-full-accordion-item').forEach(i => {
        i.classList.remove('is-open');
        const c = i.querySelector('.pp-acc-content, .pp-full-accordion-content');
        if(c) c.style.display = 'none';
      });
      
      if (!isOpen) {
        item.classList.add('is-open');
        h.setAttribute('aria-expanded', 'true');
        if(content) content.style.display = 'block';
      } else {
        h.setAttribute('aria-expanded', 'false');
        if(content) content.style.display = 'none';
      }
    });
  });

  // Variant Picking
  const variantsJsonEl = document.getElementById('pp-variants-json');
  let variants = [];
  try {
    if(variantsJsonEl) variants = JSON.parse(variantsJsonEl.textContent);
  } catch(e){}

  const formatMoney = (cents) => '₹' + (cents/100).toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 0});

  const optGroups = document.querySelectorAll('.pp-option-group');
  optGroups.forEach(group => {
    const btns = group.querySelectorAll('.pp-opt-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        
        // Find matching variant
        const selectedOptions = Array.from(optGroups).map(g => {
          const activeBtn = g.querySelector('.is-active');
          return activeBtn ? activeBtn.getAttribute('data-value') : null;
        });

        const currentVariant = variants.find(v => {
          return v.options && v.options.every((opt, i) => opt === selectedOptions[i]);
        });

        if(currentVariant) {
          const idInput = document.getElementById('pp-variant-id');
          if(idInput) idInput.value = currentVariant.id;

          const skuEl = document.getElementById('pp-sku');
          if(skuEl) skuEl.textContent = currentVariant.sku || '';

          if (currentVariant.featured_image) {
            const variantImgUrl = currentVariant.featured_image.src.split('?')[0];
            const thumbItems = document.querySelectorAll('.pp-thumb-item');
            const matchIndex = Array.from(thumbItems).findIndex(t => {
               const thumbSrc = t.getAttribute('data-image');
               return thumbSrc && thumbSrc.includes(variantImgUrl);
            });
            if (matchIndex !== -1) {
              setMainImage(matchIndex);
            } else if (mainImg) {
              mainImg.style.opacity = 0;
              setTimeout(() => {
                mainImg.src = currentVariant.featured_image.src;
                mainImg.style.opacity = 1;
              }, 150);
            }
          }

          const priceEl = document.getElementById('pp-price');
          if(priceEl) priceEl.textContent = formatMoney(currentVariant.price);

          const compPriceEl = document.getElementById('pp-compare-price');
          const discountEl = document.querySelector('.pp-price-discount');
          if(compPriceEl) {
             if(currentVariant.compare_at_price > currentVariant.price) {
               compPriceEl.textContent = formatMoney(currentVariant.compare_at_price);
               compPriceEl.style.display = 'inline';
               if(discountEl) {
                 const diff = currentVariant.compare_at_price - currentVariant.price;
                 const pct = Math.round((diff / currentVariant.compare_at_price) * 100);
                 discountEl.textContent = pct + '% OFF';
                 discountEl.style.display = 'inline';
               }
             } else {
               compPriceEl.style.display = 'none';
               if(discountEl) discountEl.style.display = 'none';
             }
          }
          
          if(history.replaceState) {
            const url = window.location.protocol + '//' + window.location.host + window.location.pathname + '?variant=' + currentVariant.id;
            window.history.replaceState({path: url}, '', url);
          }
        }
      });
    });
  });

  // Qty
  const qtyInput = document.querySelector('.pp-qty-val');
  const qtyDec = document.querySelector('.pp-qty-btn.dec');
  const qtyInc = document.querySelector('.pp-qty-btn.inc');

  if(qtyDec && qtyInc && qtyInput) {
    qtyDec.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 1;
      if(val > 1) qtyInput.value = val - 1;
    });
    qtyInc.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 1;
      qtyInput.value = val + 1;
    });
  }

  // Add to Cart
  const form = document.getElementById('pp-product-form');
  const btnAdd = document.querySelector('.pp-btn-add');
  if(form && btnAdd) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const origHtml = btnAdd.innerHTML;
      btnAdd.innerHTML = 'Adding...';
      fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
        method: 'POST',
        body: new FormData(form)
      })
      .then(() => {
        btnAdd.innerHTML = 'Added!';
        if(window.openCartDrawer) window.openCartDrawer();
        setTimeout(() => btnAdd.innerHTML = origHtml, 2000);
      })
      .catch(() => {
        btnAdd.innerHTML = 'Error';
        setTimeout(() => btnAdd.innerHTML = origHtml, 2000);
      });
    });
  }

  // Buy Now
  const btnBuy = document.getElementById('pp-buy-now');
  if(form && btnBuy) {
    btnBuy.addEventListener('click', (e) => {
      e.preventDefault();
      btnBuy.textContent = 'Processing...';
      fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
        method: 'POST',
        body: new FormData(form)
      })
      .then(() => {
        window.location.href = '/checkout';
      })
      .catch(() => {
        btnBuy.textContent = 'Error';
        setTimeout(() => btnBuy.textContent = 'Buy Now', 2000);
    });
  }

  // Product Recommendations & Carousel Navigation
  class ProductRecommendations extends HTMLElement {
    constructor() { super(); }
    connectedCallback() {
      const handleIntersection = (entries, observer) => {
        if (!entries[0].isIntersecting) return;
        observer.unobserve(this);
        if (this.dataset.url) {
          fetch(this.dataset.url)
            .then(response => response.text())
            .then(text => {
              const html = document.createElement('div');
              html.innerHTML = text;
              const recommendations = html.querySelector('product-recommendations');
              if (recommendations && recommendations.innerHTML.trim().length) {
                this.innerHTML = recommendations.innerHTML;
              }
              this.initCarousel();
            })
            .catch(e => { console.error(e); this.initCarousel(); });
        } else {
          this.initCarousel();
        }
      };
      new IntersectionObserver(handleIntersection.bind(this), {rootMargin: '0px 0px 200px 0px'}).observe(this);
      this.initCarousel();
    }
    initCarousel() {
      const grid = this.querySelector('.pp-related-grid');
      const prev = this.querySelector('.pp-rel-prev');
      const next = this.querySelector('.pp-rel-next');
      if (grid && prev && next) {
        prev.addEventListener('click', () => {
          grid.scrollBy({ left: -320, behavior: 'smooth' });
        });
        next.addEventListener('click', () => {
          grid.scrollBy({ left: 320, behavior: 'smooth' });
        });
      }
    }
  }
  if (!customElements.get('product-recommendations')) {
    customElements.define('product-recommendations', ProductRecommendations);
  }
});
</script>

<div class="pp-zoom-overlay" id="pp-zoom-overlay">
  <button class="pp-zoom-close" id="pp-zoom-close" aria-label="Close Zoom">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <img id="pp-zoom-img" src="" alt="Zoomed Image" width="1600" height="1600">
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const zoomBtn = document.querySelector('.pp-fullscreen-btn');
  const zoomOverlay = document.getElementById('pp-zoom-overlay');
  const zoomClose = document.getElementById('pp-zoom-close');
  const zoomImg = document.getElementById('pp-zoom-img');
  const mainImg = document.getElementById('pp-main-image');

  if(zoomBtn && zoomOverlay && zoomClose && zoomImg && mainImg) {
    zoomBtn.addEventListener('click', () => {
      let src = mainImg.src;
      // Change to a higher resolution if needed
      src = src.replace('width=800', 'width=1600');
      zoomImg.src = src;
      zoomOverlay.classList.add('is-active');
    });

    zoomClose.addEventListener('click', () => {
      zoomOverlay.classList.remove('is-active');
    });

    zoomOverlay.addEventListener('click', (e) => {
      if(e.target === zoomOverlay) {
        zoomOverlay.classList.remove('is-active');
      }
    });
  }
});
</script>

