    /* Luxury Mobile Breadcrumb UI: Single line nowrap with intelligent ellipsis truncation so long titles never push separators onto line 2 or cut off first letters! */
    .pp-breadcrumb-list {
      font-size: 11.5px !important;
      gap: 6px !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      white-space: nowrap !important;
      padding: 4px 0 !important;
      width: 100% !important;
      display: flex !important;
