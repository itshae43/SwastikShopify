<script>
(function() {
  // ==========================================
  // BULLETPROOF LUXURY GALLERY & ZOOM CONTROLLER
  // Uses Event Delegation and strips srcset to guarantee instant image swaps!
  // ==========================================
  window.ppActiveIndex = 0;

  function setMainImage(index) {
    const thumbs = Array.from(document.querySelectorAll('.pp-thumb-item'));
    const mainImg = document.getElementById('pp-main-image');
    const zoomImg = document.getElementById('pp-zoom-img');
    const thumbWrapper = document.querySelector('.pp-thumbnails-wrapper');

    if (!thumbs.length || !mainImg) return;
    
    // Normalize index to wrap around cleanly
    window.ppActiveIndex = (index + thumbs.length) % thumbs.length;
    
    // Update active class on thumbnails
    thumbs.forEach(t => t.classList.remove('is-active'));
    thumbs[window.ppActiveIndex].classList.add('is-active');
    
    // Extract new image source from thumbnail data-image
    const newSrc = thumbs[window.ppActiveIndex].getAttribute('data-image');
    if (newSrc) {
      // Remove srcset and sizes so browser doesn't override or ignore .src assignment!
      mainImg.removeAttribute('srcset');
      mainImg.removeAttribute('sizes');
      mainImg.setAttribute('src', newSrc);
      mainImg.src = newSrc;
      
      if (zoomImg) {
        zoomImg.removeAttribute('srcset');
        zoomImg.removeAttribute('sizes');
        let zoomSrc = newSrc.replace('width=800', 'width=1600').replace('width=1000', 'width=1600').replace('width=180', 'width=1600');
        zoomImg.setAttribute('src', zoomSrc);
        zoomImg.src = zoomSrc;
      }
    }

    // Smoothly scroll horizontal carousel to center the active thumbnail
    if (thumbWrapper && thumbs[window.ppActiveIndex]) {
      const thumbEl = thumbs[window.ppActiveIndex];
      const wrapWidth = thumbWrapper.clientWidth;
      const thumbWidth = thumbEl.clientWidth;
      const thumbLeft = thumbEl.offsetLeft;
      thumbWrapper.scrollTo({
        left: thumbLeft - (wrapWidth / 2) + (thumbWidth / 2),
        behavior: 'smooth'
      });
    }
  }

  function openZoomModal() {
    const zoomOverlay = document.getElementById('pp-zoom-overlay');
    const zoomImg = document.getElementById('pp-zoom-img');
    const mainImg = document.getElementById('pp-main-image');
    const thumbs = Array.from(document.querySelectorAll('.pp-thumb-item'));

    if (!zoomOverlay || !zoomImg || !mainImg) return;
    
    let src = thumbs.length && thumbs[window.ppActiveIndex] ? thumbs[window.ppActiveIndex].getAttribute('data-image') : mainImg.src;
    if (src) {
      src = src.replace('width=800', 'width=1600').replace('width=1000', 'width=1600').replace('width=180', 'width=1600');
      zoomImg.removeAttribute('srcset');
      zoomImg.removeAttribute('sizes');
      zoomImg.setAttribute('src', src);
      zoomImg.src = src;
    }
    zoomOverlay.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  function closeZoomModal() {
    const zoomOverlay = document.getElementById('pp-zoom-overlay');
    if (!zoomOverlay) return;
    zoomOverlay.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  // Use Event Delegation on document so clicks work 100% reliably even after Shopify DOM updates!
  document.addEventListener('click', function(e) {
    // 1. Thumbnail click
    const thumbEl = e.target.closest('.pp-thumb-item');
    if (thumbEl) {
      e.preventDefault();
      e.stopPropagation();
      const allThumbs = Array.from(document.querySelectorAll('.pp-thumb-item'));
      const idx = allThumbs.indexOf(thumbEl);
      if (idx !== -1) setMainImage(idx);
      return;
    }

    // 2. Previous Arrow (Main Gallery or Fullscreen Zoom)
    if (e.target.closest('.pp-nav-prev') || e.target.closest('#pp-zoom-prev')) {
      e.preventDefault();
      e.stopPropagation();
      setMainImage(window.ppActiveIndex - 1);
      return;
    }

    // 3. Next Arrow (Main Gallery or Fullscreen Zoom)
    if (e.target.closest('.pp-nav-next') || e.target.closest('#pp-zoom-next')) {
      e.preventDefault();
      e.stopPropagation();
      setMainImage(window.ppActiveIndex + 1);
      return;
    }

    // 4. Open Zoom Modal (Clicking [+] button or Main Image)
    if (e.target.closest('.pp-fullscreen-btn') || e.target.closest('#pp-main-image')) {
      e.preventDefault();
      e.stopPropagation();
      openZoomModal();
      return;
    }

    // 5. Close Zoom Modal (Clicking X or dark background overlay)
    if (e.target.closest('.pp-zoom-close') || (e.target.classList && e.target.classList.contains('pp-zoom-overlay'))) {
      e.preventDefault();
      e.stopPropagation();
      closeZoomModal();
      return;
    }

    // 6. Thumbnail Carousel Scroll Arrows
    if (e.target.closest('.pp-thumb-nav-prev')) {
      e.preventDefault();
      e.stopPropagation();
      const wrap = document.querySelector('.pp-thumbnails-wrapper');
      if (wrap) wrap.scrollBy({ left: -220, behavior: 'smooth' });
      return;
    }
    if (e.target.closest('.pp-thumb-nav-next')) {
      e.preventDefault();
      e.stopPropagation();
      const wrap = document.querySelector('.pp-thumbnails-wrapper');
      if (wrap) wrap.scrollBy({ left: 220, behavior: 'smooth' });
      return;
    }

    // 7. Accordion Dropdown Toggle
    const accHeader = e.target.closest('.pp-acc-header');
    if (accHeader) {
      e.preventDefault();
      const item = accHeader.closest('.pp-acc-item');
      if (item) {
        const isOpen = item.classList.contains('is-open');
        if (isOpen) {
          item.classList.remove('is-open');
          accHeader.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          accHeader.setAttribute('aria-expanded', 'true');
        }
      }
      return;
    }

    // 8. Tab Button Switching (Product Details <-> Price Breakdown)
    const tabBtn = e.target.closest('.pp-tab-btn');
    if (tabBtn) {
      e.preventDefault();
      const card = tabBtn.closest('.pp-tabs-card');
      if (card) {
        const targetId = tabBtn.getAttribute('data-target');
        card.querySelectorAll('.pp-tab-btn').forEach(b => b.classList.remove('is-active'));
        card.querySelectorAll('.pp-tab-body').forEach(b => {
          b.classList.remove('is-active');
          b.style.display = 'none';
        });
        tabBtn.classList.add('is-active');
        const targetBody = card.querySelector('#' + targetId);
        if (targetBody) {
          targetBody.classList.add('is-active');
          targetBody.style.display = 'block';
        }
      }
      return;
    }

    // 9. Read More Toggle Button (About This Jewellery)
    const readMoreBtn = e.target.closest('.pp-read-more-btn');
    if (readMoreBtn) {
      e.preventDefault();
      const moreText = document.querySelector('.pp-about-more');
      const textSpan = readMoreBtn.querySelector('.pp-rm-text');
      if (moreText) {
        if (moreText.style.display === 'none' || !moreText.style.display) {
          moreText.style.display = 'block';
          if (textSpan) textSpan.textContent = 'Read less';
          readMoreBtn.classList.add('is-expanded');
        } else {
          moreText.style.display = 'none';
          if (textSpan) textSpan.textContent = 'Read more';
          readMoreBtn.classList.remove('is-expanded');
        }
      }
      return;
    }

    // Quantity Plus/Minus Buttons
    if (e.target.closest('.pp-qty-plus')) {
      e.preventDefault();
      const input = document.querySelector('.pp-qty-input');
      if (input) input.value = parseInt(input.value || 1, 10) + 1;
      return;
    }
    if (e.target.closest('.pp-qty-minus')) {
      e.preventDefault();
      const input = document.querySelector('.pp-qty-input');
      if (input && parseInt(input.value || 1, 10) > 1) {
        input.value = parseInt(input.value || 1, 10) - 1;
      }
      return;
    }

    // Buy Now Button (Dynamic Checkout)
    if (e.target.closest('.pp-btn-buy')) {
      e.preventDefault();
      const form = document.getElementById('pp-product-form');
      if (form) {
        let retInput = form.querySelector('input[name="return_to"]');
        if (!retInput) {
          retInput = document.createElement('input');
          retInput.type = 'hidden';
          retInput.name = 'return_to';
          form.appendChild(retInput);
        }
        retInput.value = '/checkout';
        form.submit();
      }
      return;
    }

    // 8. Variant / Option Selection Button
    const optBtn = e.target.closest('.pp-opt-btn');
    if (optBtn) {
      e.preventDefault();
      const group = optBtn.closest('.pp-option-values') || optBtn.closest('.pp-option-group');
      if (group) {
        group.querySelectorAll('.pp-opt-btn').forEach(b => b.classList.remove('is-active'));
        optBtn.classList.add('is-active');
      }
      // If product has variants JSON, match selected options and update price/sku/hidden input
      const variantsJsonEl = document.getElementById('pp-variants-json');
      if (variantsJsonEl) {
        try {
          const variants = JSON.parse(variantsJsonEl.textContent || '[]');
          const activeBtns = Array.from(document.querySelectorAll('.pp-option-group .pp-opt-btn.is-active'));
          const selectedVals = activeBtns.map(b => b.getAttribute('data-value') || b.textContent.trim());
          const matched = variants.find(v => {
            return v.options && v.options.every((val, idx) => val === selectedVals[idx] || !selectedVals[idx]);
          });
          if (matched) {
            const variantIdInput = document.getElementById('pp-variant-id');
            if (variantIdInput) variantIdInput.value = matched.id;
            const priceEl = document.getElementById('pp-price');
            if (priceEl && matched.price) {
              priceEl.innerHTML = (matched.price / 100).toLocaleString('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).replace('INR', '₹');
            }
            const skuEl = document.getElementById('pp-sku');
            if (skuEl && matched.sku) skuEl.textContent = matched.sku;
          }
        } catch (err) {
          console.error('Error parsing variants JSON:', err);
        }
      }
      return;
    }
  });

  // Keyboard navigation for full screen modal
  document.addEventListener('keydown', function(e) {
    const zoomOverlay = document.getElementById('pp-zoom-overlay');
    if (e.key === 'Escape' && zoomOverlay && zoomOverlay.classList.contains('is-active')) {
      closeZoomModal();
    }
    if (e.key === 'ArrowLeft') setMainImage(window.ppActiveIndex - 1);
    if (e.key === 'ArrowRight') setMainImage(window.ppActiveIndex + 1);
  });
})();
</script>

<div class="pp-zoom-overlay" id="pp-zoom-overlay" role="dialog" aria-modal="true" aria-label="Fullscreen Zoom Gallery">
  <button class="pp-zoom-close" id="pp-zoom-close" aria-label="Close Zoom">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <img id="pp-zoom-img" src="" alt="Zoomed Luxury Jewelry" width="1600" height="1600">
</div>

